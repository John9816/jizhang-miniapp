/* 暖黄界面的动效节奏：触控 100ms，弹层退出 180ms，内容进入 260ms。 */
.btn-primary, .btn-ghost, .btn-plain, .btn-danger,
.chip, .fchip, .seg-item, .type-item, .period-item,
.recent-chip, .tf-chip, .cat-icon, .cal-cell {
  transition: background-color 160ms ease, border-color 160ms ease, color 160ms ease, box-shadow 160ms ease, transform 100ms ease, opacity 100ms ease;
}
.row, .menu-row, .bill-row, .record-row, .ledger-item, .sheet-item,
.icon-btn, .more-item, .key, .account-line {
  transition: background-color 100ms ease, opacity 100ms ease;
}
.press-soft { background-color: var(--gold-soft) !important; opacity: 0.88; }
.press-button { transform: scale(0.97); opacity: 0.86; }
.press-key { background-color: var(--gold-soft) !important; }

/* 只动画实际内容区域；固定定位的弹层和键盘不放在变换后的父容器中。 */
.motion-section, .motion-a { animation: motion-rise-a 260ms cubic-bezier(0.22, 0.8, 0.25, 1) backwards; }
.motion-b { animation: motion-rise-b 260ms cubic-bezier(0.22, 0.8, 0.25, 1) backwards; }
.motion-page { animation: none; }
.motion-page.motion-a > .motion-section { animation-name: motion-rise-a; }
.motion-page.motion-b > .motion-section { animation-name: motion-rise-b; }
.motion-delay-1 { animation-delay: 35ms; }
.motion-delay-2 { animation-delay: 70ms; }
@keyframes motion-rise-a {
  from { opacity: 0.5; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes motion-rise-b {
  from { opacity: 0.5; transform: translateY(10rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 不保留终态 transform，避免卡片内的 fixed 元素改变定位上下文。 */
.modal-mask, .sheet-mask, .poster-mask { animation: motion-mask-in 220ms ease both; }
.modal, .poster-modal { animation: motion-dialog-in 240ms cubic-bezier(0.22, 0.8, 0.25, 1); }
.sheet { animation: motion-sheet-in 260ms cubic-bezier(0.22, 0.8, 0.25, 1); }
.motion-leaving { pointer-events: auto; }
.modal-mask.motion-leaving, .sheet-mask.motion-leaving, .poster-mask.motion-leaving {
  animation: motion-mask-out 180ms ease both;
}
.modal-mask.motion-leaving .modal, .poster-mask.motion-leaving .poster-modal {
  animation: motion-dialog-out 180ms ease both;
  pointer-events: none;
}
.sheet.motion-leaving { animation: motion-sheet-out 180ms ease both; pointer-events: none; }
@keyframes motion-mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes motion-mask-out { from { opacity: 1; } to { opacity: 0; } }
@keyframes motion-dialog-in {
  from { opacity: 0; transform: translateY(16rpx) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}
@keyframes motion-dialog-out {
  from { opacity: 1; transform: translateY(0) scale(1); }
  to { opacity: 0; transform: translateY(12rpx) scale(0.98); }
}
@keyframes motion-sheet-in { from { transform: translateY(100%); } to { transform: translateY(0); } }
@keyframes motion-sheet-out { from { transform: translateY(0); } to { transform: translateY(100%); } }

.progress-bar, .hb-fill, .ch-fill { transition: width 320ms cubic-bezier(0.22, 0.8, 0.25, 1); }
.chart-tip { animation: motion-mask-in 120ms ease; }
.chart-reveal { animation: motion-chart-in 320ms ease both; }
@keyframes motion-chart-in { from { opacity: 0.25; } to { opacity: 1; } }

/* 首页金色卡片只掠过一次微光；装饰层不接收触摸事件。 */
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(110deg, transparent 30%, rgba(255, 255, 255, 0.22) 48%, transparent 66%);
  transform: translateX(120%);
  animation: motion-gold-light 640ms ease-out 60ms backwards;
}
@keyframes motion-gold-light {
  from { transform: translateX(-120%); }
  to { transform: translateX(120%); }
}

/* 遵循系统“减少动态效果”；内容直接显示，不循环播放装饰动画。 */
@media (prefers-reduced-motion: reduce) {
  .motion-section, .motion-a, .motion-b, .chart-reveal, .chart-tip,
  .modal-mask, .sheet-mask, .poster-mask, .modal, .poster-modal, .sheet,
  .modal-mask.motion-leaving .modal, .poster-mask.motion-leaving .poster-modal,
  .sheet.motion-leaving, .modal-mask.motion-leaving, .sheet-mask.motion-leaving, .poster-mask.motion-leaving {
    animation: none !important;
    transform: none !important;
  }
  .btn-primary, .btn-ghost, .btn-plain, .btn-danger, .chip, .fchip,
  .seg-item, .type-item, .period-item, .cat-icon, .recent-chip, .tf-chip, .cal-cell,
  .progress-bar, .hb-fill, .ch-fill { transition: none !important; }
  .press-button { transform: none !important; }
  .hero::after { display: none; animation: none; }
}
