page {
  background: #F6F7F9;
  color: #1F2937;
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
}

.text-income { color: #F04646; }
.text-expense { color: #07A35E; }
.muted { color: #9CA3AF; }

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  margin: 24rpx;
  padding: 28rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.04);
}

.btn-primary {
  background: #F04646;
  color: #FFFFFF;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 600;
}

.btn-ghost {
  background: #F3F4F6;
  color: #374151;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 500;
}

.btn-danger {
  background: #FFF1F0;
  color: #F04646;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 600;
}

.section-title {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 20rpx;
  font-weight: 500;
}

/* 通用弹层 */
.modal-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(17, 24, 39, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.modal {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  box-sizing: border-box;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
}

.modal-sub {
  font-size: 24rpx;
  color: #9CA3AF;
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.5;
}

.modal-input {
  margin-top: 32rpx;
  background: #F6F7F9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
}

.modal-textarea {
  margin-top: 32rpx;
  background: #F6F7F9;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
  line-height: 1.5;
}

.modal-actions {
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
}

.modal-actions .btn-primary,
.modal-actions .btn-ghost {
  flex: 1;
  padding: 22rpx 0;
  font-size: 28rpx;
}
