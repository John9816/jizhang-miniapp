@import './motion.wxss';

/* ===========================================================
   设计令牌（统一暖黄 · 纸白 · 深棕）
   =========================================================== */

view, text, scroll-view, input, textarea { box-sizing: border-box; }

/* 微信 input 默认高度不会随 padding 撑开，单行控件统一显式高度。 */
input {
  height: 88rpx;
  min-width: 0;
  line-height: normal;
  padding: 0;
  color: var(--ink);
}
textarea { line-height: 1.6; }

/* ===========================================================
   文本
   =========================================================== */

.text-expense { color: var(--expense); }
.muted { color: var(--ink-3); }
.num { font-variant-numeric: tabular-nums; letter-spacing: -0.5rpx; }

/* ===========================================================
   页面骨架
   =========================================================== */
.page {
  min-height: 100vh;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}
.page-plain { padding-bottom: 40rpx; }

/* 自定义导航占位 */
.nav-holder { width: 100%; }

/* ===========================================================
   卡片
   =========================================================== */
.card {
  background: var(--card);
  border-radius: 24rpx;
  margin: 20rpx 24rpx;
  padding: 28rpx;
  box-shadow: var(--shadow);
}
.card-flat { box-shadow: none; border: 1rpx solid var(--line); }
.card-tight { padding: 22rpx 24rpx; }

.section-title {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-bottom: 20rpx;
  font-weight: 500;
}

/* 卡片标题行 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-head-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.card-head-more {
  font-size: 24rpx;
  color: var(--ink-3);
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* ===========================================================
   按钮
   =========================================================== */
.btn-primary {
  background: linear-gradient(135deg, var(--gold) 0%, var(--gold-deep) 100%);
  color: #3B2A18;
  border-radius: 16rpx;
  text-align: center;
  font-weight: 700;
  box-shadow: 0 8rpx 18rpx rgba(217, 150, 55, 0.24);
}
.btn-primary:active { transform: scale(0.985); opacity: 0.92; }

.btn-ghost {
  background: var(--gold-soft);
  color: #9B681E;
  border-radius: 14rpx;
  text-align: center;
  font-weight: 600;
}
.btn-ghost:active { opacity: 0.85; }

.btn-danger {
  background: #FBECE9;
  color: var(--danger);
  border-radius: 999rpx;
  text-align: center;
  font-weight: 600;
}

.btn-plain {
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  color: var(--ink-2);
  border-radius: 14rpx;
  text-align: center;
  font-weight: 500;
}

/* ===========================================================
   芯片 / 标签
   =========================================================== */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  background: #FFFFFF;
  border: 1rpx solid var(--line);
  margin-right: 14rpx;
  white-space: nowrap;
}
.chip-active {
  background: var(--gold);
  border-color: var(--gold);
  color: var(--ink);
  font-weight: 600;
}

.badge {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  background: var(--gold-soft);
  color: #8A6410;
  font-weight: 600;
}
.badge-dark {
  background: #3B3529;
  color: #FFDF85;
}

/* ===========================================================
   进度条
   =========================================================== */
.progress {
  height: 12rpx;
  border-radius: 999rpx;
  background: var(--gold-track);
  overflow: hidden;
}
.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, var(--gold), var(--gold-deep));
}
.progress-bar-plain { background: linear-gradient(90deg, #E7DFCB, #C9BE9F); }

/* ===========================================================
   列表行
   =========================================================== */
.row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; }
.row-title { font-size: 29rpx; color: var(--ink); font-weight: 500; }
.row-sub { font-size: 23rpx; color: var(--ink-3); margin-top: 6rpx; }
.row-arrow { color: #CFC5AC; font-size: 30rpx; margin-left: 12rpx; }

/* ===========================================================
   空状态
   =========================================================== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 90rpx 40rpx 100rpx;
}
.empty-icon { font-size: 74rpx; opacity: 0.55; }
.empty-text {
  font-size: 26rpx;
  color: var(--ink-3);
  margin-top: 20rpx;
  text-align: center;
  line-height: 1.6;
}
.empty-btn {
  margin-top: 32rpx;
  padding: 18rpx 64rpx;
  font-size: 27rpx;
}

/* ===========================================================
   弹层
   =========================================================== */
.modal-mask {
  position: fixed;
  left: 0; right: 0; top: 0; bottom: 0;
  background: rgba(59, 42, 24, 0.46);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 620rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  max-height: 80vh;
  overflow-y: auto;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  color: var(--ink);
}
.modal-sub {
  font-size: 24rpx;
  color: var(--ink-3);
  text-align: center;
  margin-top: 12rpx;
  line-height: 1.5;
}
.modal-input {
  width: 100%;
  height: 96rpx;
  margin-top: 32rpx;
  background: var(--surface-soft);
  border-radius: 16rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--line);
  font-size: 28rpx;
  color: var(--ink);
}
.modal-input:focus { border-color: var(--gold-deep); }
.modal-textarea {
  margin-top: 32rpx;
  background: var(--surface-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: var(--ink);
  width: 100%;
  height: 160rpx;
  line-height: 1.5;
}

/* ============ 公共交互样式 ============ */
page {
  --bg: #FFF9EE;
  --bg-deep: #FFF3D7;
  --card: #FFFFFF;
  --ink: #3B2A18;
  --ink-2: #7A6A53;
  --ink-3: #9A896D;
  --line: #EFE3C7;
  --gold: #F6C95B;
  --gold-deep: #E8A72D;
  --gold-soft: #FFF0C2;
  --gold-track: #F3E4B8;
  --income: #946515;
  --expense: #3B2A18;
  --danger: #D65A45;
  --success: #946515;
  --accent-ink: #8C641E;
  --surface-soft: #FFF6E4;
  --hero-light: #FFE9A8;
  --chart-strong: #B78024;
  --shadow: 0 12rpx 28rpx rgba(86, 54, 14, 0.09);
  color: var(--ink);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  -webkit-font-smoothing: antialiased;
  background: var(--bg);
}

button::after { border: 0; }

.card,
.modal,
.sheet {
  border: 1rpx solid rgba(239, 227, 199, 0.88);
}

.row:active,
.menu-row:active,
.bill-row:active,
.more-item:active,
.icon-btn:active,
.card-head-more:active {
  background: var(--surface-soft);
  opacity: 0.9;
}

.section-title,
.card-head-more {
  letter-spacing: 0.3rpx;
}

.modal-actions {
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
}
.modal-actions .btn-primary,
.modal-actions .btn-ghost,
.modal-actions .btn-plain {
  flex: 1;
  min-width: 0;
  min-height: 88rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22rpx 0;
  font-size: 28rpx;
}

/* 底部弹出层 */

.sheet {
  box-shadow: 0 -12rpx 34rpx rgba(86, 54, 14, 0.14);
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-radius: 36rpx 36rpx 0 0;
  padding: 20rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  z-index: 121;
  max-height: 76vh;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 8rpx;
}
.sheet-item {
  padding: 30rpx 8rpx;
  font-size: 29rpx;
  text-align: center;
  color: var(--ink);
  border-bottom: 1rpx solid var(--line);
}
.sheet-item:last-child { border-bottom: none; }
.sheet-cancel {
  margin-top: 16rpx;
  padding: 30rpx 8rpx;
  font-size: 29rpx;
  text-align: center;
  color: var(--ink-3);
  border-top: 12rpx solid var(--bg);
}

/* 弹层遮罩与投影 */
.sheet,
.modal { box-shadow: 0 -12rpx 34rpx rgba(86, 54, 14, 0.16); }
.sheet-handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  margin: 6rpx auto 22rpx;
  background: #E7D7AE;
}
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 120;
  background: rgba(59, 42, 24, 0.46);
}

/* 收入金额即使与页面金额类并用，也保持统一的深金色。 */
.text-income {
  color: var(--income) !important;
}
