<view class="page motion-page">
  <view class="hero {{vip ? 'hero-vip' : ''}}">
    <view class="hero-badge">{{vip ? 'VIP' : '会员'}}</view>
    <view class="hero-title">{{vip ? '您已是永久会员' : '记账本会员'}}</view>
    <view class="hero-sub">{{vip ? '全部权益已解锁，感谢支持' : '一次买断，永久解锁全部进阶能力'}}</view>
  </view>

  <view class="benefits">
    <view class="benefit" wx:for="{{benefits}}" wx:key="title">
      <text class="b-icon">{{item.icon}}</text>
      <view class="b-text">
        <view class="b-title">{{item.title}}</view>
        <view class="b-desc">{{item.desc}}</view>
      </view>
      <text class="b-check">{{vip ? '✓' : ''}}</text>
    </view>
  </view>

  <view class="card motion-section" wx:if="{{!vip && vipOn && product}}">
    <view class="price-row">
      <text class="price">¥{{product.priceYuan}}</text>
      <text class="price-tag">{{product.tag}}</text>
    </view>
    <view class="price-period">{{product.period}} · {{product.desc}}</view>
    <button class="buy-btn" loading="{{buying}}" disabled="{{buying}}" bindtap="buy">
      {{buying ? '支付中…' : '立即开通'}}
    </button>
    <view class="pay-note">由微信官方虚拟支付保障 · 安卓费率 1% / iOS 12%</view>
  </view>

  <view class="card vip-card motion-section" wx:if="{{vip}}">
    <view class="vip-tip">已享受去广告、多账本、导出、高级图表、导入对账等全部权益</view>
  </view>

  <view class="card vip-card motion-section" wx:if="{{!vip && !vipOn}}">
    <view class="vip-tip">会员功能即将开放，敬请期待</view>
  </view>

  <view class="toast" wx:if="{{toast}}">{{toast}}</view>
</view>
