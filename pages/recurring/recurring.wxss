.preset-card {
  margin: 20rpx 24rpx 0;
  padding: 24rpx 0 8rpx;
}

.preset-head {
  padding: 0 28rpx 16rpx;
}

.preset-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.preset-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}

.preset-row {
  display: flex;
  gap: 20rpx;
  white-space: nowrap;
  padding: 0 28rpx 12rpx;
}

.preset-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.preset-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: var(--gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.preset-name {
  font-size: 22rpx;
  color: var(--ink-2);
}

.rule-card {
  margin: 20rpx 24rpx 0;
}

.rule-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rule-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  background: var(--surface-soft);
}

.rule-expense { background: #FEF2F2; }
.rule-income { background: var(--gold-soft); }

.rule-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.rule-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
}

.rule-meta {
  font-size: 20rpx;
  color: var(--ink-3);
}

.rule-amount {
  font-size: 30rpx;
  font-weight: 600;
}

.rule-ops {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--surface-soft);
}

.rule-op {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: var(--gold-deep);
  padding: 12rpx 0;
  border-radius: 12rpx;
  background: var(--gold-soft);
}

.rule-op-paused {
  color: var(--ink-3);
  background: var(--surface-soft);
}

.rule-op-del {
  color: var(--danger);
  background: #FEF2F2;
}

.add-btn {
  margin: 24rpx;
  padding: 22rpx 0;
  text-align: center;
  border-radius: 16rpx;
  background: var(--gold);
  color: var(--ink);
  font-size: 28rpx;
}

.notice-card {
  margin: 24rpx 24rpx 60rpx;
}

.modal-scroll {
  max-height: 78vh;
}

.form-label {
  font-size: 24rpx;
  color: var(--ink-2);
  padding: 16rpx 0 8rpx;
}

.form-types {
  display: flex;
  gap: 16rpx;
}

.form-type {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 12rpx;
  background: var(--surface-soft);
  color: var(--ink-2);
  font-size: 26rpx;
}

.form-type-active {
  background: var(--gold-soft);
  color: var(--gold-deep);
  font-weight: 500;
}

.amount-row-modal {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.amount-sign {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.modal-input-inline {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 32rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--line);
  padding: 0 8rpx;
}

.cat-chips {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
}

.cat-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
  color: var(--ink-2);
  font-size: 24rpx;
  flex-shrink: 0;
}

.cat-chip-active {
  background: var(--gold-soft);
  color: var(--gold-deep);
}

.form-value {
  font-size: 28rpx;
  color: var(--ink);
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--line);
}

.modal-actions-modal {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 24rpx;
}

.modal-actions-modal .btn-primary,
.modal-actions-modal .btn-ghost {
  margin: 0;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  border-radius: 16rpx;
}
