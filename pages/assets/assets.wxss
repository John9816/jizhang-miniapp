.net-card {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, var(--gold-deep), #E8A317);
  color: var(--ink);
}

.net-positive {
  background: linear-gradient(135deg, var(--gold-deep), #E8A317);
}

.net-negative {
  background: linear-gradient(135deg, var(--gold-soft), #F6D990);
  border: 1rpx solid var(--line);
}

.net-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.net-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 12rpx 0 24rpx;
}

.net-sign {
  font-size: 32rpx;
  opacity: 0.9;
}

.net-value {
  font-size: 56rpx;
  font-weight: 700;
}

.net-actions {
  display: flex;
  gap: 16rpx;
}

.net-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.65);
  font-size: 26rpx;
}

/* 分组小计 */
.sum-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
}

.sum-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.sum-row + .sum-row {
  border-top: 1rpx solid var(--surface-soft);
}

.sum-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sum-name {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}

.sum-count {
  font-size: 20rpx;
  color: var(--ink-3);
}

.sum-val {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}

/* 账户列表 */
.acc-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--surface-soft);
}

.acc-row:last-child {
  border-bottom: none;
}

.acc-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.acc-main {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.acc-name {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 500;
  word-break: break-all;
}

.acc-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.acc-default {
  font-size: 18rpx;
  color: #8A6D1F;
  background: var(--hero-light);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-weight: 500;
  line-height: 1.4;
}

.acc-type {
  font-size: 20rpx;
  color: var(--ink-3);
}

.acc-balance {
  font-size: 30rpx;
  font-weight: 600;
  margin-left: 12rpx;
  flex-shrink: 0;
}

.section-hint {
  display: block;
  font-size: 20rpx;
  color: var(--ink-3);
  font-weight: 400;
  margin-top: 6rpx;
}

.group-total {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  font-weight: 600;
}

/* 管理弹层 */
.modal-scroll {
  max-height: 70vh;
}

.modal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.modal-label {
  width: 128rpx;
  font-size: 26rpx;
  color: var(--ink-2);
}

.modal-input-inline {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: 28rpx;
  color: var(--ink);
  border-bottom: 1rpx solid var(--line);
  padding: 0 8rpx;
}

.type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.initial-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.initial-sign {
  font-size: 28rpx;
  color: var(--ink);
}
.balance-sign-btn { flex: 0 0 76rpx; min-width: 0; max-width: 76rpx; margin: 0; padding: 0; width: 76rpx; line-height: 80rpx; font-size: 34rpx; color: var(--accent-ink); background: var(--gold-soft); border-radius: 16rpx; }
.balance-sign-btn::after { border: 0; }

.modal-actions-modal {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 24rpx;
}

.modal-actions-modal .btn-primary,
.modal-actions-modal .btn-danger-outline,
.modal-actions-modal .btn-ghost {
  margin: 0;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.btn-danger-outline {
  color: var(--danger);
  border: 1rpx solid var(--danger);
}

.manage-hint {
  font-size: 20rpx;
  color: var(--ink-3);
  text-align: center;
  padding: 16rpx 0 8rpx;
}

.account-chip { border: 1rpx solid var(--line); border-radius: 12rpx; padding: 12rpx 16rpx; font-size: 23rpx; line-height: 1.5; color: var(--ink-2); }
.account-active { background: var(--gold-soft); border-color: var(--gold-deep); color: var(--accent-ink); }
.flow-title { margin: 32rpx 32rpx 8rpx; font-size: 28rpx; font-weight: 600; color: var(--ink); }
.group-card { padding: 0 24rpx; }
.group-head { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; padding: 22rpx 0; border-bottom: 1rpx solid var(--line); }
.group-date { font-size: 23rpx; color: var(--ink-2); }
.group-sub { display: flex; gap: 12rpx; flex-shrink: 0; font-size: 21rpx; color: var(--ink-3); }
.record-row { display: flex; align-items: center; gap: 16rpx; padding: 24rpx 0; border-bottom: 1rpx solid var(--line); }
.record-row:last-child { border-bottom: 0; }
.rec-icon { flex-shrink: 0; width: 68rpx; height: 68rpx; border-radius: 20rpx; background: var(--gold-soft); text-align: center; line-height: 68rpx; font-size: 30rpx; }
.rec-main { flex: 1; min-width: 0; }
.rec-title { display: flex; align-items: center; gap: 8rpx; font-size: 26rpx; color: var(--ink); }
.rec-title > text:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rec-member { font-size: 19rpx; flex-shrink: 0; color: var(--ink-3); }
.rec-note { display: block; margin-top: 6rpx; font-size: 22rpx; line-height: 1.5; color: var(--ink-3); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.rec-amount { flex-shrink: 0; font-size: 28rpx; font-weight: 600; }
.fab { position: fixed; right: 32rpx; bottom: calc(40rpx + env(safe-area-inset-bottom)); width: 100rpx; height: 100rpx; line-height: 96rpx; text-align: center; border-radius: 50%; background: var(--gold); color: var(--ink); font-size: 54rpx; box-shadow: var(--shadow); z-index: 20; }

.asset-overview { display:flex; gap:16rpx; padding:12rpx 0 28rpx; }
.asset-overview > view { flex:1; min-width:0; display:flex; flex-direction:column; gap:10rpx; font-size:22rpx; }
.overview-value { font-size:27rpx; font-weight:700; word-break:break-all; }
.acc-right { display:flex; flex-direction:column; align-items:flex-end; max-width:55%; }
.acc-right .acc-balance { font-size:28rpx; word-break:break-all; }
.acc-tools { display:flex; gap:10rpx; margin-top:8rpx; }
.acc-tools > view { padding:14rpx 20rpx; border-radius:14rpx; background:var(--gold-soft); color:var(--accent-ink); font-size:22rpx; }
.account-filter { width:100%; margin:0 0 20rpx; }
.filter-items { display:flex; gap:12rpx; padding:0 24rpx; width:max-content; }
.filter-chip { flex-shrink:0; padding:18rpx 26rpx; border-radius:999rpx; background:var(--surface); color:var(--ink-2); font-size:24rpx; }
.filter-active { background:var(--gold); font-weight:700; color:var(--ink); }
