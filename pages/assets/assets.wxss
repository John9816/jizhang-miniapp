.net-card {
  margin: 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F5B417, #E8A317);
  color: #FFFFFF;
}

.net-positive {
  background: linear-gradient(135deg, #F5B417, #E8A317);
}

.net-negative {
  background: linear-gradient(135deg, #B91C1C, #DC2626);
}

.net-label {
  font-size: 24rpx;
  opacity: 0.85;
}

.net-value-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
  padding: 12rpx 0 24rpx;
}

.net-sign {
  font-size: 32rpx;
  opacity: 0.9;
}

.net-value {
  font-size: 56rpx;
  font-weight: 700;
}

.net-actions {
  display: flex;
  gap: 16rpx;
}

.net-btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 26rpx;
}

/* 分组小计 */
.sum-card {
  margin: 0 24rpx 20rpx;
  padding: 24rpx 28rpx;
}

.sum-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
}

.sum-row + .sum-row {
  border-top: 1rpx solid #F7F1E2;
}

.sum-left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.sum-name {
  font-size: 26rpx;
  color: #2E2A22;
  font-weight: 500;
}

.sum-count {
  font-size: 20rpx;
  color: #A79E8B;
}

.sum-val {
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2A22;
}

/* 账户列表 */
.acc-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F7F1E2;
}

.acc-row:last-child {
  border-bottom: none;
}

.acc-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: #F7F1E2;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 20rpx;
}

.acc-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.acc-name {
  font-size: 28rpx;
  color: #2E2A22;
  font-weight: 500;
}

.acc-name-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.acc-default {
  font-size: 18rpx;
  color: #8A6D1F;
  background: #FFE9A8;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-weight: 500;
  line-height: 1.4;
}

.acc-type {
  font-size: 20rpx;
  color: #A79E8B;
}

.acc-balance {
  font-size: 30rpx;
  font-weight: 600;
}

.section-hint {
  display: block;
  font-size: 20rpx;
  color: #A79E8B;
  font-weight: 400;
  margin-top: 6rpx;
}

.group-total {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  font-size: 24rpx;
  color: #6B6455;
  font-weight: 600;
}

/* 管理弹层 */
.modal-scroll {
  max-height: 70vh;
}

.modal-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
}

.modal-label {
  width: 128rpx;
  font-size: 26rpx;
  color: #6B6455;
}

.modal-input-inline {
  flex: 1;
  font-size: 28rpx;
  color: #2E2A22;
  border-bottom: 1rpx solid #F0E9D8;
  padding: 8rpx 0;
}

.type-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  flex: 1;
}

.initial-row {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.initial-sign {
  font-size: 28rpx;
  color: #2E2A22;
}

.modal-actions-modal {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 24rpx;
}

.modal-actions-modal .btn-primary,
.modal-actions-modal .btn-danger-outline,
.modal-actions-modal .btn-ghost {
  margin: 0;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
  border-radius: 16rpx;
}

.btn-danger-outline {
  color: #E2543F;
  border: 1rpx solid #E2543F;
}

.manage-hint {
  font-size: 20rpx;
  color: #A79E8B;
  text-align: center;
  padding: 16rpx 0 8rpx;
}
