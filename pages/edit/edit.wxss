.page {
  padding: 16rpx 0 60rpx;
  box-sizing: border-box;
}

/* 类型切换 */
.type-bar {
  display: flex;
  margin: 16rpx 24rpx 8rpx;
  background: #E5E7EB;
  border-radius: 16rpx;
  padding: 6rpx;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #6B7280;
  border-radius: 12rpx;
  font-weight: 500;
}

.type-active {
  background: #FFFFFF;
  color: #F04646;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(31, 41, 55, 0.08);
}

/* 金额 */
.amount-card {
  padding: 40rpx 32rpx;
}

.amount-row {
  display: flex;
  align-items: baseline;
  border-bottom: 1rpx solid #EEF0F3;
  padding-bottom: 20rpx;
}

.amount-sign {
  font-size: 44rpx;
  font-weight: 700;
  color: #1F2937;
  margin-right: 16rpx;
}

.amount-input {
  flex: 1;
  font-size: 72rpx;
  font-weight: 700;
  color: #1F2937;
  height: 96rpx;
  line-height: 96rpx;
}

.amount-ph {
  color: #D1D5DB;
  font-size: 56rpx;
  font-weight: 400;
}

/* 分类 */
.cat-grid {
  display: flex;
  flex-wrap: wrap;
}

.cat-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
  box-sizing: border-box;
}

.cat-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: #F6F7F9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  border: 2rpx solid transparent;
  box-sizing: border-box;
}

.cat-name {
  font-size: 22rpx;
  color: #6B7280;
  margin-top: 10rpx;
}

.cat-active .cat-icon {
  background: #FFF1F0;
  border-color: #F04646;
}

.cat-active .cat-name {
  color: #F04646;
  font-weight: 600;
}

/* 表单 */
.form-card {
  padding: 8rpx 28rpx;
}

.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F6F7F9;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #374151;
  font-weight: 500;
}

.form-value-row {
  display: flex;
  align-items: center;
}

.form-value {
  font-size: 28rpx;
  color: #1F2937;
}

.form-arrow {
  color: #9CA3AF;
  margin-left: 8rpx;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #1F2937;
  margin-left: 40rpx;
}

/* 操作按钮 */
.save-btn {
  margin: 32rpx 24rpx 0;
  padding: 24rpx 0;
  font-size: 30rpx;
}

.delete-btn {
  margin: 20rpx 24rpx 0;
  padding: 22rpx 0;
  font-size: 28rpx;
}

/* 账户 chips */
.account-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.account-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 26rpx;
}

.account-chip-icon {
  font-size: 28rpx;
}

.account-active {
  background: #EEF2FF;
  color: #4F46E5;
  font-weight: 500;
}

.account-disabled {
  opacity: 0.35;
}

.account-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 转账流程 */
.transfer-flow {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.transfer-side {
  flex: 1;
  min-width: 0;
}

.transfer-caption {
  font-size: 24rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
}

.transfer-arrow {
  font-size: 36rpx;
  color: #4F46E5;
  padding-top: 32rpx;
}
