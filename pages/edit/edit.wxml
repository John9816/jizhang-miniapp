<view class="page">
  <!-- 收支类型 / 转账 -->
  <view class="type-bar">
    <view class="type-item {{mode === 'normal' && type === 'expense' ? 'type-active' : ''}}" bindtap="setMode" data-mode="normal" data-type="expense">支出</view>
    <view class="type-item {{mode === 'normal' && type === 'income' ? 'type-active' : ''}}" bindtap="setMode" data-mode="normal" data-type="income">收入</view>
    <view class="type-item {{mode === 'transfer' ? 'type-active' : ''}}" bindtap="setMode" data-mode="transfer">转账</view>
  </view>

  <!-- 金额 -->
  <view class="card amount-card">
    <view class="amount-row">
      <text class="amount-sign">¥</text>
      <input class="amount-input" type="digit" value="{{amountInput}}" placeholder="0.00" placeholder-class="amount-ph" bindinput="onAmountInput" />
    </view>
  </view>

  <!-- 转账：账户选择 -->
  <view class="card" wx:if="{{mode === 'transfer'}}">
    <view class="section-title">账户</view>
    <view class="transfer-flow">
      <view class="transfer-side">
        <view class="transfer-caption">转出</view>
        <view class="account-chips">
          <view class="account-chip {{accountId === item.id ? 'account-active' : ''}} {{item.id === transferTo ? 'account-disabled' : ''}}" wx:for="{{accounts}}" wx:key="id" bindtap="setAccount" data-id="{{item.id}}" data-field="from">
            <text class="account-chip-icon">{{item.icon}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
      <view class="transfer-arrow">→</view>
      <view class="transfer-side">
        <view class="transfer-caption">转入</view>
        <view class="account-chips">
          <view class="account-chip {{transferTo === item.id ? 'account-active' : ''}} {{item.id === accountId ? 'account-disabled' : ''}}" wx:for="{{accounts}}" wx:key="id" bindtap="setAccount" data-id="{{item.id}}" data-field="to">
            <text class="account-chip-icon">{{item.icon}}</text>
            <text>{{item.name}}</text>
          </view>
        </view>
      </view>
    </view>
    <view class="account-tip" wx:if="{{!accountId || !transferTo}}">选择转出与转入账户（不计入收支统计）</view>
  </view>

  <!-- 分类（转账模式隐藏） -->
  <view class="card" wx:if="{{mode !== 'transfer'}}">
    <view class="section-title">分类</view>
    <view class="cat-grid">
      <view class="cat-item {{category === item.key ? 'cat-active' : ''}}" wx:for="{{categories}}" wx:key="key" bindtap="setCategory" data-key="{{item.key}}">
        <view class="cat-icon">{{item.icon}}</view>
        <text class="cat-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 账户（普通模式） -->
  <view class="card" wx:if="{{mode !== 'transfer' && accounts.length > 0}}">
    <view class="section-title">账户（选填）</view>
    <view class="account-chips">
      <view class="account-chip {{accountId === '' ? 'account-active' : ''}}" bindtap="setAccount" data-id="" data-field="from">
        <text>不计</text>
      </view>
      <view class="account-chip {{accountId === item.id ? 'account-active' : ''}}" wx:for="{{accounts}}" wx:key="id" bindtap="setAccount" data-id="{{item.id}}" data-field="from">
        <text class="account-chip-icon">{{item.icon}}</text>
        <text>{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 日期与备注 -->
  <view class="card form-card">
    <picker mode="date" value="{{date}}" start="2020-01-01" end="2035-12-31" bindchange="onDateChange">
      <view class="form-row">
        <text class="form-label">日期</text>
        <view class="form-value-row">
          <text class="form-value">{{date}}</text>
          <text class="form-arrow">›</text>
        </view>
      </view>
    </picker>
    <view class="form-row">
      <text class="form-label">备注</text>
      <input class="form-input" value="{{note}}" placeholder="点击填写备注（选填）" maxlength="50" bindinput="onNoteInput" />
    </view>
  </view>

  <!-- 操作 -->
  <view class="save-btn btn-primary" bindtap="onSave">{{editingId ? '保存修改' : (mode === 'transfer' ? '确认转账' : '记一笔')}}</view>
  <view class="delete-btn btn-danger" wx:if="{{editingId}}" bindtap="onDelete">删除这条记录</view>
</view>
