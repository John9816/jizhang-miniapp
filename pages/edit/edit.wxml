<view class="edit-page motion-page {{pageMotion}}" style="height:{{pageH - keyboardHeight}}px">
  <view style="height:{{contentTop}}px; flex-shrink:0"></view>

  <!-- 顶部返回与类型，保存统一在底部主按钮 -->
  <view class="nav">
    <view class="nav-btn" role="button" aria-label="返回上一页" bindtap="onCancel" hover-class="press-soft">返回</view>
    <view class="seg">
      <view class="seg-item {{mode !== 'transfer' && type === 'expense' ? 'seg-on' : ''}}" bindtap="setType" data-type="expense" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">支出</view>
      <view class="seg-item {{mode !== 'transfer' && type === 'income' ? 'seg-on' : ''}}" bindtap="setType" data-type="income" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">收入</view>
      <view class="seg-item {{mode === 'transfer' ? 'seg-on' : ''}}" bindtap="setType" data-type="transfer" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">转账</view>
    </view>
    <text class="nav-caption">{{templateMode ? '模板' : (editingId ? '编辑' : '记一笔')}}</text>
  </view>

  <!-- 金额 -->
  <view class="amount-block motion-section">
    <view class="amount-row">
      <text class="amount-cur">¥</text>
      <text class="amount-val num {{amountInput ? '' : 'amount-ghost'}}">{{amountInput || '0.00'}}</text>
    </view>

    <view class="amount-foot">
      <text class="calc-hint" wx:if="{{calcHint}}">{{calcHint}}</text>
      <text class="calc-hint" wx:else>{{mode === 'transfer' ? '转账不计入收支' : (type === 'expense' ? '记一笔支出' : '记一笔收入')}}</text>
      <!-- 所属账本（纯展示；记账归属当前打开的账本） -->
      <view class="ledger-line">
        <text>{{ledgerName}}</text>
      </view>
    </view>
  </view>

  <!-- 主体：分类 / 转账账户 + 备注日期 -->
  <view class="mid">
    <scroll-view scroll-y class="mid-scroll">
      <view class="template-form-hint" wx:if="{{templateMode}}">{{templateEditingId ? '编辑常用模板' : '新建常用模板'}} · 保存模板不会记账</view>
      <view class="template-form-warning" wx:if="{{templateWarning}}">{{templateWarning}}</view>
      <block wx:if="{{mode === 'normal'}}">
        <view class="cat-grid">
          <view class="cat-item" wx:for="{{categories}}" wx:key="key" bindtap="setCategory" data-key="{{item.key}}" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">
            <view class="cat-icon {{category === item.key ? 'cat-icon-on' : ''}}" style="background:{{item.tint}}">
              <text class="cat-emoji">{{item.icon}}</text>
            </view>
            <text class="cat-name {{category === item.key ? 'cat-name-on' : ''}}">{{item.name}}</text>
          </view>
        </view>
      </block>

      <block wx:else>
        <view class="transfer-block">
          <view class="tf-group">
            <text class="tf-label">转出账户</text>
            <scroll-view scroll-x class="tf-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
              <view class="tf-chip {{accountId === item.id ? 'tf-chip-on' : ''}}" wx:for="{{accounts}}" wx:key="id" bindtap="setAccount" data-id="{{item.id}}" data-field="from" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">
                <text class="tf-chip-icon">{{item.icon}}</text>
                <text>{{item.name}}</text>
              </view>
            </scroll-view>
          </view>
          <view class="tf-arrow">↓</view>
          <view class="tf-group">
            <text class="tf-label">转入账户</text>
            <scroll-view scroll-x class="tf-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
              <view class="tf-chip {{transferTo === item.id ? 'tf-chip-on' : ''}} {{item.id === accountId ? 'tf-chip-off' : ''}}" wx:for="{{accounts}}" wx:key="id" bindtap="setAccount" data-id="{{item.id}}" data-field="to" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">
                <text class="tf-chip-icon">{{item.icon}}</text>
                <text>{{item.name}}</text>
              </view>
            </scroll-view>
          </view>
        </view>
      </block>

    </scroll-view>
  </view>

  <!-- 日期、账户和备注固定可见，不随分类列表滚走 -->
  <view class="entry-meta">
    <view class="entry-tools">
      <date-picker wx:if="{{!templateMode}}" value="{{date}}" start="2020-01-01" end="2035-12-31" bindchange="onDateChange">
        <view class="entry-tool" role="button"><text class="entry-tool-value">{{dateLabel}}</text><text class="entry-chevron">⌄</text></view>
      </date-picker>
      <view class="entry-tool entry-account" wx:if="{{mode === 'normal'}}" role="button" aria-label="选择记账账户" bindtap="openAccounts" hover-class="press-soft">
        <text class="entry-tool-value">{{accountName || '不指定账户'}}</text><text class="entry-chevron">⌄</text>
      </view>
      <view class="entry-continue" wx:if="{{!editingId && !recordUnavailable && !templateMode}}" role="checkbox" aria-checked="{{continueEntry}}" bindtap="toggleContinue" hover-class="press-soft">
        <view class="entry-check {{continueEntry ? 'entry-check-on' : ''}}">{{continueEntry ? '✓' : ''}}</view><text>连续记账</text>
      </view>
    </view>
    <view class="entry-note-row">
      <text class="entry-note-label">备注</text>
      <input class="note-input" value="{{note}}" placeholder="添加备注（选填）" placeholder-class="note-ph" maxlength="50"
        focus="{{noteFocused}}" confirm-type="done" bindinput="onNoteInput" bindfocus="onNoteFocus" bindblur="onNoteBlur"
        bindconfirm="finishNote" bindkeyboardheightchange="onNoteKeyboard" adjust-position="{{false}}" />
      <view class="note-finish" wx:if="{{noteFocused}}" role="button" bindtap="finishNote">完成</view>
    </view>
    <view class="entry-feedback" wx:if="{{saveFeedback}}" aria-live="polite">{{saveFeedback}}</view>
  </view>

  <!-- 数字键盘 -->
  <view class="keypad" wx:if="{{!noteFocused}}">
    <view class="key" bindtap="pressKey" data-k="7" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">7</view>
    <view class="key" bindtap="pressKey" data-k="8" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">8</view>
    <view class="key" bindtap="pressKey" data-k="9" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">9</view>
    <view class="key key-fn" bindtap="pressKey" data-k="del" bindlongpress="clearAmount" aria-label="退格，长按清空金额" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">⌫</view>

    <view class="key" bindtap="pressKey" data-k="4" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">4</view>
    <view class="key" bindtap="pressKey" data-k="5" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">5</view>
    <view class="key" bindtap="pressKey" data-k="6" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">6</view>
    <view class="key key-fn" bindtap="pressKey" data-k="+" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">＋</view>

    <view class="key" bindtap="pressKey" data-k="1" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">1</view>
    <view class="key" bindtap="pressKey" data-k="2" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">2</view>
    <view class="key" bindtap="pressKey" data-k="3" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">3</view>
    <view class="key key-fn" bindtap="pressKey" data-k="-" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">−</view>

    <view class="key" bindtap="pressKey" data-k="." hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">.</view>
    <view class="key" bindtap="pressKey" data-k="0" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">0</view>
    <view class="key key-done {{canSave && !saving ? '' : 'key-done-off'}}" bindtap="onSave" hover-class="press-key" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">{{saving ? '保存中' : (templateMode ? '保存模板' : (continueEntry && !editingId ? '保存并继续' : '保存'))}}</view>
  </view>

  <!-- 账户选择弹层 -->
  <view class="sheet-mask {{showAccountsLeaving ? 'motion-leaving' : ''}}" wx:if="{{showAccounts || showAccountsLeaving}}" bindtap="closeAccounts"></view>
  <view class="sheet account-sheet {{showAccountsLeaving ? 'motion-leaving' : ''}}" wx:if="{{showAccounts || showAccountsLeaving}}">
    <view class="sheet-handle"></view>
    <view class="sheet-title">选择账户</view>
    <scroll-view scroll-y class="accounts-options">
      <view class="sheet-item {{accountId === '' ? 'sheet-item-on' : ''}}" bindtap="setAccount" data-id="" data-field="from" hover-class="press-soft" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">不指定账户 {{accountId === '' ? '✓' : ''}}</view>
      <view class="sheet-item {{accountId === item.id ? 'sheet-item-on' : ''}}" wx:for="{{accounts}}" wx:key="id" bindtap="setAccount" data-id="{{item.id}}" data-field="from" hover-class="press-soft" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">{{item.icon}} {{item.name}} {{accountId === item.id ? '✓' : ''}}</view>
    </scroll-view>
    <view class="sheet-cancel" bindtap="closeAccounts" hover-class="press-soft" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">取消</view>
  </view>
</view>
