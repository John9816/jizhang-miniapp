<view class="page stats-page">
  <view style="height:{{statusBar}}px"></view>

  <!-- 标题 -->
  <view class="s-head">
    <text class="s-title">统计</text>
    <image class="s-mascot" src="/images/mascot-sm.png" mode="aspectFit" />
  </view>

  <!-- 周期主行：翻期 + 当前周期（大字号，唯一一处周期标签） -->
  <view class="pn-bar" wx:if="{{period !== 'custom'}}">
    <text class="pn-btn" bindtap="prevPeriod">‹</text>
    <text class="pn-label">{{periodLabel}}</text>
    <text class="pn-btn" bindtap="nextPeriod">›</text>
  </view>
  <view class="pn-bar" wx:else>
    <text class="pn-label pn-label-custom" bindtap="setPeriod" data-period="custom">{{periodLabel}} · 点击修改</text>
  </view>

  <!-- 口径行：支出/收入 切换 + 周期 选择，同一行 -->
  <view class="scope-bar">
    <view class="type-seg">
      <view class="type-item {{pieType === 'expense' ? 'type-on' : ''}}" bindtap="setPieType" data-type="expense">支出</view>
      <view class="type-item {{pieType === 'income' ? 'type-on' : ''}}" bindtap="setPieType" data-type="income">收入</view>
    </view>
    <view class="period-bar">
      <view class="period-item {{period === item.key ? 'period-on' : ''}}" wx:for="{{periods}}" wx:key="key" bindtap="setPeriod" data-period="{{item.key}}">{{item.name}}</view>
    </view>
  </view>

  <!-- 总览 + 折线图 -->
  <view class="card sum-card">
    <view class="sum-line">
      <text class="sum-label">{{mainLabel}}</text>
      <text class="sum-mom {{momUp ? 'mom-up' : 'mom-down'}}" wx:if="{{hasData}}">较上期 {{momText}}</text>
    </view>
    <text class="sum-amount num">{{mainTotal}}</text>
    <text class="sum-daily">日均{{pieType === 'income' ? '收入' : '支出'}} {{dailyText}}</text>

    <view class="chart-wrap">
      <canvas type="2d" id="lineCanvas" class="line-canvas" bindtouchstart="onChartTouch"></canvas>
      <view class="chart-tip" wx:if="{{tip}}" style="left:{{tip.left}}px; top:{{tip.top}}px">
        <text class="tip-date">{{tip.date}}</text>
        <text class="tip-val">{{tip.label}} {{tip.value}}</text>
      </view>
      <view class="chart-empty" wx:if="{{!hasData}}">
        <text class="chart-empty-text">这个周期还没有记录</text>
      </view>
    </view>
  </view>

  <!-- 占比 -->
  <view class="card pie-card">
    <view class="card-head">
      <text class="card-head-title">{{pieType === 'income' ? '收入' : '支出'}}占比</text>
      <text class="card-head-more">{{pieItems.length}} 个分类</text>
    </view>

    <view class="pie-row" wx:if="{{pieItems.length > 0}}">
      <view class="pie-left">
        <canvas type="2d" id="pieCanvas" class="pie-canvas"></canvas>
      </view>
      <view class="legend">
        <view class="legend-item" wx:for="{{pieItems}}" wx:key="key">
          <view class="legend-dot" style="background:{{item.color}}"></view>
          <text class="legend-name">{{item.name}}</text>
          <text class="legend-pct num">{{item.pct}}%</text>
          <text class="legend-amt num">{{item.amountText}}</text>
        </view>
      </view>
    </view>

    <view class="empty" wx:else style="padding:50rpx 0">
      <text class="empty-text">暂无分类数据</text>
    </view>
  </view>

  <!-- 近 12 个月 -->
  <view class="card bar-card">
    <view class="card-head">
      <text class="card-head-title">近 12 个月支出</text>
    </view>
    <canvas type="2d" id="barCanvas" class="bar-canvas"></canvas>
  </view>

  <view class="poster-btn btn-ghost" bindtap="makePoster">生成 {{periodLabel}} 海报</view>

  <!-- 自定义区间 -->
  <view class="modal-mask" wx:if="{{showCustom}}">
    <view class="modal">
      <view class="modal-title">选择日期范围</view>
      <view class="modal-sub">最多统计 1 年内的记录</view>
      <picker mode="date" value="{{customStart}}" start="2020-01-01" end="2035-12-31" bindchange="onCustomStart">
        <view class="date-row">
          <text class="date-row-label">开始</text>
          <text class="date-row-value">{{customStart}}</text>
        </view>
      </picker>
      <picker mode="date" value="{{customEnd}}" start="2020-01-01" end="2035-12-31" bindchange="onCustomEnd">
        <view class="date-row">
          <text class="date-row-label">结束</text>
          <text class="date-row-value">{{customEnd}}</text>
        </view>
      </picker>
      <view class="modal-actions">
        <view class="btn-plain" bindtap="cancelCustom">取消</view>
        <view class="btn-primary" bindtap="applyCustom">确定</view>
      </view>
    </view>
  </view>

  <!-- 海报离屏画布 -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas"></canvas>
</view>
