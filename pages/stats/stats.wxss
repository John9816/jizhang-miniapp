.period-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}

.period-item {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6B7280;
  font-size: 26rpx;
}

.period-active {
  background: #4F46E5;
  color: #FFFFFF;
  font-weight: 500;
}

.period-nav {
  margin-left: auto;
  display: flex;
  gap: 12rpx;
}

.period-nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #4F46E5;
  font-size: 32rpx;
  text-align: center;
  line-height: 56rpx;
}

.period-label {
  text-align: center;
  font-size: 24rpx;
  color: #6B7280;
  padding: 12rpx 0 4rpx;
}

.custom-card {
  margin: 16rpx 24rpx 0;
}

.custom-apply {
  margin-top: 16rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

.summary-card {
  display: flex;
  margin: 16rpx 24rpx 0;
  padding: 28rpx 24rpx;
}

.sum-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.sum-label {
  font-size: 24rpx;
  color: #6B7280;
}

.sum-value {
  font-size: 32rpx;
  font-weight: 600;
}

.sum-mom {
  font-size: 20rpx;
  color: #9CA3AF;
}

.sum-divider {
  width: 1rpx;
  background: #E5E7EB;
}

.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pie-switch {
  display: flex;
  background: #F3F4F6;
  border-radius: 999rpx;
  padding: 4rpx;
}

.pie-switch-item {
  padding: 6rpx 24rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  color: #6B7280;
}

.pie-active {
  background: #FFFFFF;
  color: #4F46E5;
  font-weight: 500;
}

.pie-wrap {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  max-height: 480rpx;
  margin: 0 auto;
}

.pie-canvas {
  width: 100%;
  height: 100%;
}

.pie-center {
  position: absolute;
  left: 0;
  right: 0;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  pointer-events: none;
}

.pie-center-label {
  font-size: 22rpx;
  color: #9CA3AF;
}

.pie-center-value {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2937;
}

.pie-legend {
  margin-top: 16rpx;
}

.legend-row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.legend-name {
  flex: 1;
  font-size: 26rpx;
  color: #374151;
}

.legend-pct {
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
  margin-right: 16rpx;
}

.legend-amount {
  font-size: 24rpx;
  color: #9CA3AF;
  width: 160rpx;
  text-align: right;
}

/* 排行 */
.rank-row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  gap: 16rpx;
}

.rank-index {
  width: 40rpx;
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 600;
}

.rank-top {
  color: #4F46E5;
}

.rank-name {
  width: 160rpx;
  font-size: 26rpx;
  color: #374151;
}

.rank-bar {
  flex: 1;
  height: 16rpx;
  background: #F3F4F6;
  border-radius: 999rpx;
  overflow: hidden;
}

.rank-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #818CF8, #4F46E5);
  border-radius: 999rpx;
}

.rank-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.rank-amount {
  font-size: 26rpx;
  color: #111827;
  font-weight: 500;
}

.rank-count {
  font-size: 20rpx;
  color: #9CA3AF;
}

/* 图表 */
.chart-canvas {
  width: 100%;
  height: 260rpx;
  margin-top: 16rpx;
}

.trend-legend {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.trend-legend-item {
  display: flex;
  align-items: center;
  font-size: 22rpx;
  color: #6B7280;
}

.trend-line {
  width: 24rpx;
  height: 6rpx;
  border-radius: 3rpx;
  margin-right: 8rpx;
}

.trend-expense { background: #4F46E5; }
.trend-income { background: #10B981; }

/* 海报 */
.poster-tip {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 4rpx;
}

.poster-btn {
  margin-top: 20rpx;
  padding: 22rpx 0;
  font-size: 28rpx;
}

.poster-canvas {
  width: 100%;
  height: 480rpx;
  margin-top: 24rpx;
}
