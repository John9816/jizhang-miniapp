/* 底部为自定义 tabBar 预留空间 */
.stats-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }

/* ============ 标题 ============ */
.s-head {
  position: relative;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 32rpx 0;
}
.s-title {
  display: block;
  font-size: 44rpx;
  font-weight: 800;
  color: #2E2A22;
}
.s-mascot {
  width: 132rpx;
  height: 132rpx;
  margin-top: -6rpx;
  opacity: 0.96;
}

/* ============ 周期主行（翻期 + 当前周期，大字号居中） ============ */
.pn-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: 14rpx;
}
.pn-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #FFFFFF;
  color: #8A8474;
  font-size: 30rpx;
  box-shadow: 0 4rpx 14rpx rgba(196, 158, 54, 0.10);
}
.pn-label {
  font-size: 32rpx;
  color: #2E2A22;
  font-weight: 700;
  min-width: 200rpx;
  text-align: center;
}
.pn-label-custom { color: #6B6455; font-size: 26rpx; font-weight: 600; }

/* ============ 口径行：支出/收入 + 周期 同排 ============ */
.scope-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin: 20rpx 32rpx 0;
}
.type-seg {
  display: flex;
  padding: 6rpx;
  background: #F1E8D2;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.type-item {
  padding: 10rpx 28rpx;
  text-align: center;
  font-size: 25rpx;
  color: #8A8474;
  border-radius: 999rpx;
  line-height: 1.2;
}
.type-on {
  background: #FFFFFF;
  color: #2E2A22;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(180, 140, 40, 0.14);
}
.period-bar {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.period-item {
  padding: 10rpx 18rpx;
  font-size: 24rpx;
  color: #8A8474;
  border-radius: 999rpx;
  line-height: 1.2;
  white-space: nowrap;
}
.period-on {
  background: #FFF3D0;
  color: #6B4E06;
  font-weight: 600;
}

/* ============ 总览 ============ */
.sum-card { padding: 26rpx 24rpx 18rpx; }
.sum-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.sum-label {
  font-size: 26rpx;
  color: #6B6455;
}
.sum-mom { font-size: 22rpx; }
.mom-up { color: #E2543F; }
.mom-down { color: #3F9A6B; }

.sum-amount {
  display: block;
  font-size: 62rpx;
  font-weight: 800;
  color: #2E2A22;
  margin-top: 6rpx;
  letter-spacing: -1rpx;
  line-height: 1.15;
}
.sum-daily {
  display: block;
  font-size: 22rpx;
  color: #A79E8B;
  margin-top: 4rpx;
}

.chart-wrap {
  position: relative;
  margin-top: 14rpx;
}
.line-canvas {
  width: 100%;
  height: 200px;
}
.chart-tip {
  position: absolute;
  width: 116px;
  padding: 6px 8px;
  background: #FFFBEE;
  border: 1px solid #F3E2B4;
  border-radius: 8px;
  box-shadow: 0 4px 12px rgba(196, 158, 54, 0.14);
  pointer-events: none;
}
.tip-date {
  display: block;
  font-size: 10px;
  color: #A79E8B;
  line-height: 1.4;
}
.tip-val {
  display: block;
  font-size: 11px;
  font-weight: 700;
  color: #2E2A22;
  line-height: 1.4;
}
.chart-empty {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chart-empty-text {
  font-size: 23rpx;
  color: #BEB5A1;
}

/* ============ 占比 ============ */
.pie-card { padding: 26rpx 24rpx 24rpx; }
.pie-row { display: flex; align-items: center; gap: 12rpx; }
.pie-left {
  width: 150px;
  height: 150px;
  flex-shrink: 0;
}
.pie-canvas { width: 150px; height: 150px; }

.legend { flex: 1; min-width: 0; }
.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 7rpx 0;
}
.legend-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.legend-name {
  flex: 1;
  font-size: 23rpx;
  color: #6B6455;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.legend-pct {
  width: 74rpx;
  text-align: right;
  font-size: 22rpx;
  color: #8A8474;
}
.legend-amt {
  width: 118rpx;
  text-align: right;
  font-size: 22rpx;
  color: #2E2A22;
  font-weight: 500;
}

/* ============ 近 12 个月 ============ */
.bar-card { padding: 26rpx 24rpx 14rpx; }
.bar-canvas { width: 100%; height: 150px; }

/* ============ 海报按钮 ============ */
.poster-btn {
  margin: 24rpx 24rpx 0;
  padding: 24rpx 0;
  font-size: 26rpx;
}

/* ============ 自定义区间 ============ */
.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #FAF7EC;
  border-radius: 16rpx;
}
.date-row-label { font-size: 25rpx; color: #8A8474; }
.date-row-value { font-size: 26rpx; color: #2E2A22; font-weight: 500; }

/* ============ 离屏海报画布 ============ */
.poster-canvas {
  position: fixed;
  left: -2000px;
  top: 0;
  width: 620rpx;
  height: 470px;
}
