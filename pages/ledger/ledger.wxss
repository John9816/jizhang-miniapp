/* 底部为自定义 tabBar 预留空间 */
.ledger-page { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }

/* ============ 页头：标题 + 吉祥物（与统计页一致） ============ */
.l-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 4rpx;
}
.l-title {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--ink);
}
.l-mascot {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

/* ============ 当前账本：金色主卡 ============ */
.ledger-hero {
  position: relative;
  margin: 16rpx 24rpx 0;
  padding: 32rpx 30rpx 26rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, var(--hero-light) 0%, var(--gold) 46%, var(--gold-deep) 100%);
  box-shadow: 0 14rpx 34rpx rgba(240, 180, 23, 0.28);
  overflow: hidden;
}
/* 装饰圆（与首页 hero 同一语言） */
.lh-coin {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}
.lh-coin.c1 { width: 150rpx; height: 150rpx; right: 88rpx; top: -46rpx; }
.lh-coin.c2 { width: 76rpx; height: 76rpx; right: 36rpx; top: 48rpx; opacity: 0.6; }

.lh-top {
  position: relative;
  display: flex;
  align-items: center;
}

/* 大封面：自定义图 = 白底圆角衬底；预设 = 自身渐变 */
.lh-cover {
  width: 112rpx;
  height: 112rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
  box-shadow: 0 8rpx 20rpx rgba(160, 110, 10, 0.18);
}
.lh-cover-img {
  background: #FFFFFF;
  padding: 8rpx;
  overflow: hidden;
}
.lh-cover-img image {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.lh-info {
  flex: 1;
  min-width: 0;
}
.lh-name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.lh-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #4A3200;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 380rpx;
}
.lh-badge {
  font-size: 18rpx;
  color: #6B4E06;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 8rpx;
  padding: 3rpx 12rpx;
  font-weight: 600;
  flex-shrink: 0;
  line-height: 1.4;
}
.lh-sub {
  display: block;
  font-size: 22rpx;
  color: rgba(74, 50, 0, 0.62);
  margin-top: 10rpx;
}

.lh-stats {
  position: relative;
  display: flex;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.5);
}
.lh-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.lh-stat-label {
  font-size: 22rpx;
  color: rgba(74, 50, 0, 0.62);
}
.lh-stat-value {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A3200;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}
/* 金底上提高优先级：收入用深红、支出/结余用深棕，保证对比度 */
.lh-stat-value.text-income { color: #C22E1F; }
.lh-stat-value.text-expense { color: #4A3200; }

/* ============ 共享账本 ============ */
.share-actions {
  display: flex;
  gap: 20rpx;
}
.share-btn {
  flex: 1;
  padding: 20rpx 0;
  font-size: 27rpx;
}
.share-tip {
  margin-top: 24rpx;
  background: var(--gold-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}
.share-tip-line {
  display: block;
  font-size: 22rpx;
  color: var(--ink-2);
  line-height: 1.9;
}
.wx-share-btn {
  margin-top: 24rpx;
  background: var(--surface-soft);
  color: var(--ink-2);
  font-size: 26rpx;
  border-radius: 16rpx;
  padding: 18rpx 0;
  line-height: 1.6;
}
.wx-share-btn::after { border: none; }

/* ============ 我的账本 ============ */
.list-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}
.create-link {
  font-size: 26rpx;
  color: #B8860B;
  font-weight: 600;
  padding: 8rpx 16rpx;
  background: var(--gold-soft);
  border-radius: 999rpx;
}
.create-link:active { opacity: 0.75; }

.ledger-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid var(--line);
}
.ledger-row:last-child { border-bottom: none; }

/* 当前账本指示：对勾圆点（替代单选圈） */
.ledger-check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #DDD4BE;
  margin-right: 18rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  font-size: 20rpx;
  color: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}
.check-on {
  border-color: var(--gold-deep);
  background: var(--gold);
  color: #4A3200;
  font-weight: 700;
}

/* 账本封面缩略（预设 = 渐变底 + emoji；自定义 = 图片铺满） */
.ledger-row-cover {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.ledger-row-cover image {
  width: 100%;
  height: 100%;
}
.ledger-row-info {
  flex: 1;
  min-width: 0;
}
.ledger-row-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
}
.ledger-row-sub {
  display: block;
  font-size: 20rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
}
.ledger-row-ops {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}
/* 操作改为小药丸，和整体圆角语言一致 */
.op-pill {
  font-size: 22rpx;
  color: var(--ink-2);
  background: var(--surface-soft);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  line-height: 1.4;
}
.op-pill:active { background: var(--gold-soft); }
.op-pill-danger {
  color: #B03A2B;
  background: #FDEEEB;
}
.op-pill-danger:active { background: #FBDCD6; }

/* ============ 本地模式说明 ============ */
.notice-card {
  background: #FFFBEB;
  box-shadow: none;
}
.notice-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #A8811C;
}
.notice-text {
  font-size: 22rpx;
  color: #92400E;
  line-height: 1.7;
  margin-top: 10rpx;
}

.paste-link {
  text-align: center;
  font-size: 24rpx;
  color: #B8860B;
  margin-top: 16rpx;
  padding: 8rpx 0;
}

/* CSV 导出入口 */
.export-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: var(--surface-soft);
  border: 1rpx solid var(--line);
}
.export-row:active { background: var(--gold-soft); }
.export-icon { font-size: 36rpx; }
.export-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.export-title {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}
.export-sub {
  font-size: 20rpx;
  color: var(--ink-3);
}
.export-arrow {
  font-size: 30rpx;
  color: #DDD4BE;
}
