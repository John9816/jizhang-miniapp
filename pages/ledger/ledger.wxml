<view class="page ledger-page motion-page">
  <!-- 顶部一行：标题 + 吉祥物（与统计页一致的页头体系） -->
  <view class="l-head motion-section">
    <text class="l-title">账本</text>
    <image class="l-mascot" src="/images/mascot-sm.png" mode="aspectFit" />
  </view>

  <!-- 当前账本：金色主卡 + 大封面（皮卡丘签名样式，与首页 hero 一致） -->
  <view class="ledger-hero motion-section" wx:if="{{ledger}}">
    <view class="lh-coin c1"></view>
    <view class="lh-coin c2"></view>
    <view class="lh-top">
      <view class="lh-cover lh-cover-img" wx:if="{{currentCover.kind === 'image'}}">
        <image src="{{currentCover.image}}" mode="aspectFill" />
      </view>
      <view class="lh-cover" wx:else style="background: {{currentCover.gradient}}">{{currentCover.emoji}}</view>
      <view class="lh-info">
        <view class="lh-name-row">
          <text class="lh-name">{{ledger.name}}</text>
          <text class="lh-badge">当前</text>
        </view>
        <text class="lh-sub">{{memberCount}} 位成员 · {{stats.count}} 条记录</text>
      </view>
    </view>
    <view class="lh-stats">
      <view class="lh-stat">
        <text class="lh-stat-label">累计收入</text>
        <text class="lh-stat-value text-income">¥{{stats.incomeText}}</text>
      </view>
      <view class="lh-stat">
        <text class="lh-stat-label">累计支出</text>
        <text class="lh-stat-value text-expense">¥{{stats.expenseText}}</text>
      </view>
      <view class="lh-stat">
        <text class="lh-stat-label">结余</text>
        <text class="lh-stat-value">¥{{stats.balanceText}}</text>
      </view>
    </view>
  </view>

  <!-- 共享账本 -->
  <view class="card motion-section">
    <view class="card-head">
      <text class="card-head-title">共享账本</text>
      <text class="card-head-more">{{cloud ? '☁️ 实时同步中' : '📱 本地模式'}}</text>
    </view>
    <view class="export-row" bindtap="goMembers" role="button" aria-label="打开成员管理" hover-class="press-soft">
      <text class="export-icon">👥</text>
      <view class="export-main"><text class="export-title">成员管理</text><text class="export-sub">查看与管理当前账本的 {{memberCount}} 位成员</text></view>
      <text class="export-arrow">›</text>
    </view>
    <block wx:if="{{cloud}}">
      <view class="share-actions">
        <view class="share-btn btn-primary" bindtap="copyInvite" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">复制邀请码</view>
        <view class="share-btn btn-ghost" bindtap="openImport" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">输入邀请码</view>
      </view>
      <view class="share-tip">
        <text class="share-tip-line">1. 点「复制邀请码」，通过微信发给好友；</text>
        <text class="share-tip-line">2. 好友打开本小程序 → 账本 → 输入邀请码即可加入；</text>
        <text class="share-tip-line">3. 加入后双方记录实时同步，账目自动合并；</text>
        <text class="share-tip-line">4. 当前邀请码：{{inviteCode || '首次同步后生成'}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="share-actions">
        <view class="share-btn btn-primary" bindtap="copySharePackage" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">复制分享包</view>
        <view class="share-btn btn-ghost" bindtap="openImport" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">加入账本</view>
      </view>
      <view class="share-tip">
        <text class="share-tip-line">1. 点「复制分享包」，通过微信等发送给好友；</text>
        <text class="share-tip-line">2. 好友打开本小程序 → 账本 → 加入账本 → 粘贴分享包；</text>
        <text class="share-tip-line">3. 双方即可看到同一份账本，记录会标注是谁记的；</text>
        <text class="share-tip-line">4. 各自记录的条目先保存在自己手机上，下次复制分享包即可互相同步。</text>
      </view>
    </block>
    <button class="wx-share-btn" open-type="share">把小程序分享给微信好友</button>
    <view class="export-row" bindtap="exportCSV" hover-class="press-soft" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">
      <text class="export-icon">📤</text>
      <view class="export-main">
        <text class="export-title">导出账本 CSV</text>
        <text class="export-sub">生成 CSV 文件或复制内容，用表格查看</text>
      </view>
      <text class="export-arrow">›</text>
    </view>
  </view>

  <!-- 我的账本 -->
  <view class="card motion-section">
    <view class="list-head">
      <text class="card-head-title">我的账本</text>
      <view class="create-link" bindtap="openCreate" hover-class="press-soft" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">＋ 新建</view>
    </view>
    <view class="ledger-row" wx:for="{{ledgers}}" wx:key="id" bindtap="switchLedger" data-id="{{item.id}}" hover-class="press-soft" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">
      <view class="ledger-check {{item.isCurrent ? 'check-on' : ''}}">✓</view>
      <view class="ledger-row-cover ledger-row-cover-img" wx:if="{{item.cover.kind === 'image'}}">
        <image src="{{item.cover.image}}" mode="aspectFill" />
      </view>
      <view class="ledger-row-cover" wx:else style="background: {{item.cover.gradient}}">{{item.cover.emoji}}</view>
      <view class="ledger-row-info">
        <text class="ledger-row-name">{{item.name}}</text>
        <text class="ledger-row-sub">{{item.memberCount}} 位成员{{item.isCurrent ? ' · 使用中' : ''}}</text>
      </view>
      <view class="ledger-row-ops">
        <text class="op-pill" catchtap="openRename" data-id="{{item.id}}" data-name="{{item.name}}">重命名</text>
        <text class="op-pill op-pill-danger" catchtap="deleteLedger" data-id="{{item.id}}" data-name="{{item.name}}">删除</text>
      </view>
    </view>
  </view>

  <!-- 模式说明 -->
  <view class="card notice-card motion-section">
    <view class="notice-title">{{cloud ? '☁️ 云端账本已开启' : '📱 当前为本地存储模式'}}</view>
    <view class="notice-text">{{cloud ? '记录实时同步到你自己的服务器，更换设备后重新进入小程序即可恢复全部账目。' : '数据保存在本机，卸载小程序或更换设备前请先复制分享包备份。需要多人实时同步时，可以在后续升级为云端账本。'}}</view>
  </view>

  <!-- 新建账本弹层 -->
  <view class="modal-mask" wx:if="{{showCreate}}">
    <view class="modal">
      <view class="modal-title">新建账本</view>
      <input class="modal-input" value="{{newName}}" placeholder="例如：家庭账本、旅行基金" maxlength="20" bindinput="onNewNameInput" />
      <ledger-cover-picker cover="{{newCover}}" title="封面" bindcoverchange="onCreateCoverChange" />
      <view class="modal-actions">
        <view class="btn-ghost" bindtap="closeCreate" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">取消</view>
        <view class="btn-primary" bindtap="confirmCreate" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">创建</view>
      </view>
    </view>
  </view>

  <!-- 加入账本弹层 -->
  <view class="modal-mask" wx:if="{{showImport}}">
    <view class="modal">
      <view class="modal-title">加入账本</view>
      <view class="modal-sub" wx:if="{{cloud}}">输入好友的邀请码，实时共享同一份账本</view>
      <view class="modal-sub" wx:else>粘贴好友发送的分享包，合并他账本里的全部记录</view>
      <input wx:if="{{cloud}}" class="modal-input" value="{{importText}}" placeholder="输入 8 位邀请码" maxlength="8" bindinput="onImportInput" />
      <textarea wx:else class="modal-textarea" value="{{importText}}" placeholder="在此粘贴分享包（JZ1. 开头的一长串字符）" maxlength="-1" bindinput="onImportInput" />
      <view class="paste-link" wx:if="{{!cloud}}" bindtap="pasteImport" hover-class="press-soft" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">从剪贴板粘贴</view>
      <view class="modal-actions">
        <view class="btn-ghost" bindtap="closeImport" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">取消</view>
        <view class="btn-primary" bindtap="confirmImport" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">{{cloud ? '加入' : '导入'}}</view>
      </view>
    </view>
  </view>

  <!-- 重命名弹层 -->
  <view class="modal-mask" wx:if="{{showRename}}">
    <view class="modal">
      <view class="modal-title">重命名账本</view>
      <input class="modal-input" value="{{renameText}}" placeholder="账本名称" maxlength="20" bindinput="onRenameInput" />
      <ledger-cover-picker cover="{{renameCover}}" title="封面" bindcoverchange="onRenameCoverChange" />
      <view class="modal-actions">
        <view class="btn-ghost" bindtap="closeRename" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">取消</view>
        <view class="btn-primary" bindtap="confirmRename" hover-class="press-button" hover-start-time="0" hover-stay-time="70" hover-stop-propagation="{{true}}">保存</view>
      </view>
    </view>
  </view>
</view>
