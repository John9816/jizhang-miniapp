.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-add {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  font-size: 24rpx;
  color: var(--accent-ink);
  padding: 12rpx 20rpx;
}

.total-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 4rpx;
}

.total-sign {
  font-size: 34rpx;
  color: var(--ink);
  font-weight: 600;
}

.total-input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--ink);
}

.total-save {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.total-status {
  margin-top: 12rpx;
}

.total-bar,
.cat-bar {
  height: 16rpx;
  background: var(--surface-soft);
  border-radius: 999rpx;
  overflow: hidden;
}

.total-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, var(--gold), var(--chart-strong));
  border-radius: 999rpx;
  transition: width 0.3s;
}

.bar-over {
  background: linear-gradient(90deg, #FCA5A5, #EF4444);
}

.total-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: var(--ink-2);
  padding-top: 8rpx;
}

.total-hint {
  font-size: 22rpx;
  color: var(--ink-3);
  padding-top: 12rpx;
}

.cat-budget {
  padding: 20rpx 0;
  border-bottom: 1rpx solid var(--surface-soft);
}

.cat-budget-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cat-budget-name {
  font-size: 26rpx;
  color: var(--ink-2);
}

.cat-budget-nums {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: var(--ink);
  font-weight: 500;
}

.cat-budget-del {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin: -18rpx -12rpx -18rpx 0;
  font-size: 26rpx;
  color: var(--ink-2);
}

.cat-budget .cat-bar {
  margin: 12rpx 0 8rpx;
}

.cat-budget .cat-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, var(--gold), var(--gold-deep));
  border-radius: 999rpx;
}

.cat-budget .cat-bar-inner.bar-over {
  background: linear-gradient(90deg, #FCA5A5, #EF4444);
}

.cat-budget-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: var(--ink-3);
}

.cat-empty {
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
  padding: 12rpx 0;
}
.budget-guide { background: linear-gradient(135deg, var(--gold-soft), #FFFDF7); border: 1rpx solid var(--line); }
.guide-head { display: flex; justify-content: space-between; align-items: center; gap: 12rpx; color: var(--ink-2); font-size: 26rpx; }
.guide-days { font-size: 21rpx; color: var(--ink-3); }
.guide-remaining { font-size: 52rpx; font-weight: 700; color: var(--ink); margin: 12rpx 0 24rpx; word-break: break-all; }
.guide-metrics { display: flex; gap: 20rpx; }
.guide-metrics > view { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 8rpx; }
.guide-label { font-size: 22rpx; color: var(--ink-3); }
.guide-number { font-size: 30rpx; font-weight: 600; color: var(--ink); word-break: break-all; }
.guide-status { margin-top: 24rpx; font-size: 25rpx; color: var(--accent-ink); line-height: 1.6; }
.guide-method, .guide-future { font-size: 21rpx; color: var(--ink-3); line-height: 1.7; margin-top: 12rpx; }
.guide-future { display: block; }
.budget-category-scroll { max-height: 30vh; margin-bottom: 20rpx; }
.budget-category-grid { display: flex; flex-wrap: wrap; gap: 12rpx; padding: 4rpx; }
.budget-category { padding: 14rpx 18rpx; border-radius: 14rpx; font-size: 25rpx; border: 1rpx solid var(--line); color: var(--ink-2); }
.budget-category-on { background: var(--gold-soft); border-color: var(--gold-deep); color: var(--accent-ink); font-weight: 600; }
