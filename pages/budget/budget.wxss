.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cat-add {
  font-size: 24rpx;
  color: #4F46E5;
  padding: 8rpx 16rpx;
}

.total-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 0 4rpx;
}

.total-sign {
  font-size: 34rpx;
  color: #111827;
  font-weight: 600;
}

.total-input {
  flex: 1;
  font-size: 40rpx;
  font-weight: 600;
  color: #111827;
}

.total-save {
  padding: 14rpx 36rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.total-status {
  margin-top: 12rpx;
}

.total-bar,
.cat-bar {
  height: 16rpx;
  background: #F3F4F6;
  border-radius: 999rpx;
  overflow: hidden;
}

.total-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #5EEAD4, #0D9488);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.bar-over {
  background: linear-gradient(90deg, #FCA5A5, #EF4444);
}

.total-meta {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #6B7280;
  padding-top: 8rpx;
}

.total-hint {
  font-size: 22rpx;
  color: #9CA3AF;
  padding-top: 12rpx;
}

.cat-budget {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.cat-budget-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.cat-budget-name {
  font-size: 26rpx;
  color: #374151;
}

.cat-budget-nums {
  flex: 1;
  text-align: right;
  font-size: 24rpx;
  color: #111827;
  font-weight: 500;
}

.cat-budget-del {
  font-size: 24rpx;
  color: #D1D5DB;
  padding: 0 8rpx;
}

.cat-budget .cat-bar {
  margin: 12rpx 0 8rpx;
}

.cat-budget .cat-bar-inner {
  height: 100%;
  background: linear-gradient(90deg, #818CF8, #4F46E5);
  border-radius: 999rpx;
}

.cat-budget .cat-bar-inner.bar-over {
  background: linear-gradient(90deg, #FCA5A5, #EF4444);
}

.cat-budget-meta {
  display: flex;
  justify-content: space-between;
  font-size: 20rpx;
  color: #9CA3AF;
}

.cat-empty {
  font-size: 24rpx;
  color: #9CA3AF;
  line-height: 1.6;
  padding: 12rpx 0;
}
