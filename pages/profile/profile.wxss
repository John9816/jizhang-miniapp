.profile-page { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }

/* ============ 顶部资料卡（暖金渐变单卡，收拢头像/昵称/同步状态） ============ */
.p-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFF7E0 0%, #FFE6AE 100%);
  box-shadow: 0 12rpx 32rpx rgba(196, 158, 54, 0.18);
  overflow: hidden;
}
/* 右上角柔光装饰，让渐变不那么平 */
.p-glow {
  position: absolute;
  right: -60rpx;
  top: -80rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.45);
}
.p-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.avatar-box {
  position: relative;
  flex-shrink: 0;
}
.p-avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #FFF3D0;
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(160, 120, 30, 0.18);
}
.avatar-cam {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  padding: 0;
  line-height: 1;
  box-shadow: 0 4rpx 12rpx rgba(196, 158, 54, 0.26);
}
.p-info {
  flex: 1;
  min-width: 0;
}
.p-name-input {
  font-size: 34rpx;
  font-weight: 800;
  color: #2E2A22;
  width: 100%;
  height: 50rpx;
  line-height: 50rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
/* 状态行：点按 = 失败重试 / 手动同步 */
.p-meta {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  min-width: 0;
}
.p-meta:active { opacity: 0.6; }
.p-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
  background: #B9B2A3;
}
.p-dot.ok { background: #3FA34D; }
.p-dot.busy { background: #E9A825; }
.p-dot.bad { background: #D9534F; }
.p-meta-text {
  font-size: 23rpx;
  color: #6F6757;
  font-weight: 600;
  flex-shrink: 0;
}
.p-meta-sync {
  font-size: 21rpx;
  color: #A79E8B;
  margin-left: 6rpx;
  flex-shrink: 0;
}
.p-meta-id {
  font-size: 21rpx;
  color: #B4AC9C;
  margin-left: auto;
  padding-left: 16rpx;
  white-space: nowrap;
}
.p-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
}
.p-icon:active { opacity: 0.6; }

/* ============ 会员卡 ============ */
.vip-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, #3B3529 0%, #2A251C 100%);
  box-shadow: 0 10rpx 26rpx rgba(46, 42, 34, 0.20);
}
.vip-l { flex: 1; min-width: 0; }
.vip-title-line { display: flex; align-items: center; gap: 10rpx; }
.vip-crown { font-size: 26rpx; }
.vip-title {
  font-size: 27rpx;
  font-weight: 700;
  color: #FFE3A0;
}
.vip-sub {
  display: block;
  font-size: 21rpx;
  color: rgba(255, 227, 160, 0.62);
  margin-top: 8rpx;
}
.vip-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #FFE58A, #F5B417);
  color: #4A3200;
  font-size: 23rpx;
  font-weight: 700;
  flex-shrink: 0;
}

/* ============ 资产卡 ============ */
.asset-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 28rpx 24rpx;
}
.asset-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.asset-title {
  font-size: 26rpx;
  color: #6B6455;
}
.asset-link { font-size: 22rpx; color: #C0A160; }
.asset-total {
  display: block;
  font-size: 58rpx;
  font-weight: 800;
  color: #2E2A22;
  margin-top: 8rpx;
  letter-spacing: -1rpx;
  padding-right: 150rpx;   /* 右侧留给吉祥物 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.asset-split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26rpx;
  margin-top: 16rpx;
  padding-right: 150rpx;   /* 右侧留给吉祥物 */
}
.asset-col { display: flex; flex-direction: column; }
.asset-label { font-size: 21rpx; color: #A79E8B; }
.asset-val {
  font-size: 27rpx;
  font-weight: 600;
  color: #2E2A22;
  margin-top: 4rpx;
}
.asset-divider {
  width: 1rpx;
  height: 36rpx;
  background: #F0E9D8;
}
.asset-mascot {
  position: absolute;
  right: -6rpx;
  bottom: -14rpx;
  width: 168rpx;
  height: 176rpx;
  opacity: 0.95;
}

/* ============ 菜单 ============ */
.menu { padding: 6rpx 28rpx; }
.menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid #F4EEDF;
}
.menu-row:last-child { border-bottom: none; }
.menu-icon { font-size: 30rpx; width: 40rpx; text-align: center; }
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #2E2A22;
}
.menu-extra {
  font-size: 22rpx;
  color: #B9B2A3;
}
.menu-arrow { font-size: 28rpx; color: #D5CCB8; }

.p-footer {
  text-align: center;
  font-size: 21rpx;
  color: #C7BEAA;
  padding: 30rpx 0 10rpx;
}

/* ============ 帮助列表 ============ */
.help-list { margin-top: 24rpx; }
.help-item {
  font-size: 24rpx;
  color: #6B6455;
  line-height: 1.8;
}
.help-api {
  margin: 18rpx 0 4rpx;
  padding: 18rpx 20rpx;
  background: #FAF7EC;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #A8811C;
  word-break: break-all;
}
