.profile-page { padding-bottom: calc(190rpx + env(safe-area-inset-bottom)); }

/* ============ 顶部资料卡（暖金渐变单卡，收拢头像/昵称/同步状态） ============ */

/* 装饰圆：与首页主卡同一套语言（低透明度白圆）；替代此前生硬的白色大光斑 */

.p-coin.c1 { width: 170rpx; height: 170rpx; right: -40rpx; top: -60rpx; }
.p-coin.c2 { width: 84rpx; height: 84rpx; right: 110rpx; bottom: -28rpx; opacity: 0.55; }
.p-user {
  display: flex;
  align-items: center;
  gap: 24rpx;
  flex: 1;
  min-width: 0;
  position: relative;
  z-index: 1;
}
.avatar-box {
  position: relative;
  flex-shrink: 0;
  width: 112rpx;
  height: 112rpx;
}
.avatar-frame {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--gold-soft);
  border: 6rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 20rpx rgba(86, 54, 14, 0.18);
  box-sizing: border-box;
}

.p-info {
  flex: 1;
  min-width: 0;
}

/* 状态行与列表中的设置入口保持相同行为 */
.p-meta {
  display: flex;
  flex-wrap: wrap;
  row-gap: 8rpx;
  align-items: center;
  margin-top: 10rpx;
  min-width: 0;
}
.p-meta:active { opacity: 0.6; }
.p-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 10rpx;
  flex-shrink: 0;
  background: var(--ink-3);
}
.p-dot.ok { background: var(--income); }
.p-dot.busy { background: #E9A825; }
.p-dot.bad { background: #D9534F; }

.p-meta-sync {
  font-size: 21rpx;
  color: #7A6F58;
  margin-left: 6rpx;
  flex-shrink: 0;
}
.p-meta-id {
  font-size: 21rpx;
  color: #8A7E64;
  margin-left: auto;
  padding-left: 16rpx;
  white-space: nowrap;
}

.p-icon:active { opacity: 0.6; }

/* ============ 会员卡 ============ */

.vip-l { flex: 1; min-width: 0; }
.vip-title-line { display: flex; align-items: center; gap: 10rpx; }
.vip-crown { font-size: 26rpx; }

/* ============ 资产卡 ============ */
.asset-card {
  position: relative;
  overflow: hidden;
  padding: 26rpx 28rpx 24rpx;
}
.asset-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.asset-total {
  display: block;
  font-size: 58rpx;
  font-weight: 800;
  color: var(--ink);
  margin-top: 8rpx;
  letter-spacing: -1rpx;
  padding-right: 150rpx;   /* 右侧留给吉祥物 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.asset-split {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 26rpx;
  margin-top: 16rpx;
  padding-right: 150rpx;   /* 右侧留给吉祥物 */
}
.asset-col { display: flex; flex-direction: column; }

.asset-val {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--ink);
  margin-top: 4rpx;
}

.asset-mascot {
  position: absolute;
  right: -6rpx;
  bottom: -14rpx;
  width: 168rpx;
  height: 176rpx;
  opacity: 0.95;
}

/* ============ 菜单 ============ */
.menu { padding: 6rpx 28rpx; }
.menu-group-title { margin: 28rpx 36rpx 10rpx; color: var(--ink-3); font-size: 24rpx; font-weight: 600; }
.menu-group .menu { margin-top: 0; }
.p-meta-arrow { margin-left: 10rpx; color: var(--accent-ink); font-size: 28rpx; }
.support-links { display: flex; align-items: center; justify-content: center; gap: 16rpx; margin-top: 24rpx; color: var(--ink-3); font-size: 24rpx; }
.support-link { padding: 20rpx 12rpx; min-height: 88rpx; box-sizing: border-box; display: flex; align-items: center; }
.support-divider { color: var(--ink-3); }

.menu-row:last-child { border-bottom: none; }
.menu-icon { font-size: 30rpx; width: 40rpx; text-align: center; }

/* ============ 帮助列表 ============ */
.help-list { margin-top: 24rpx; }

/* ============ 我的主题 ============ */
.p-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 20rpx 24rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, var(--hero-light) 0%, var(--gold) 62%, var(--gold-deep) 100%);
  box-shadow: 0 16rpx 30rpx rgba(232, 167, 45, 0.22);
}
.p-coin {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.p-avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  border: 0;
  box-shadow: none;
  transform: scale(1.01);
  background: var(--gold-soft);
  border-color: rgba(255, 255, 255, 0.88);
}
/* 覆盖 style v2 的 button[size=mini] 默认内边距与行高。 */
button.avatar-cam[size='mini'] {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 64rpx;
  height: 64rpx;
  min-width: 64rpx;
  margin: 0;
  border-radius: 50%;
  background: #FFFFFF;
  border: 2rpx solid #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  padding: 0;
  overflow: hidden;
  line-height: 1;
  box-sizing: border-box;
  box-shadow: 0 6rpx 14rpx rgba(86, 54, 14, 0.16);
}
.p-name-input {
  font-size: 34rpx;
  font-weight: 800;
  width: 100%;
  height: 64rpx;
  line-height: normal;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
}
.p-name-ph {
  font-weight: 500;
  color: var(--ink-2);
}
.p-meta-text {
  font-size: 23rpx;
  font-weight: 600;
  flex-shrink: 0;
  color: var(--ink);
}
.p-meta-sync,
.p-meta-id { color: var(--ink); }
.p-icon {
  width: 80rpx;
  height: 80rpx;
  flex-shrink: 0;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  flex-shrink: 0;
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.62);
  color: var(--accent-ink);
}
.settings-icon { width: 40rpx; height: 40rpx; }
.vip-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 20rpx 24rpx 0;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(135deg, var(--gold-soft) 0%, var(--gold) 100%);
  box-shadow: 0 12rpx 26rpx rgba(86, 54, 14, 0.18);
}
.vip-title {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--ink);
}
.vip-sub {
  display: block;
  font-size: 21rpx;
  margin-top: 8rpx;
  color: var(--ink-2);
}
.vip-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
  flex-shrink: 0;
  background: var(--ink);
  color: var(--gold-soft);
}
.asset-title {
  font-size: 26rpx;
  color: var(--ink-2);
}
.asset-link {
  font-size: 22rpx;
  color: var(--gold-deep);
}
.asset-total,
.asset-val { color: var(--ink); }
.asset-label {
  font-size: 21rpx;
  color: var(--ink-3);
}
.asset-divider {
  width: 1rpx;
  height: 36rpx;
  background: var(--line);
}
.menu-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 26rpx 0;
  border-bottom: 1rpx solid var(--line);
  border-bottom-color: var(--line);
}
.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}
.menu-extra {
  font-size: 22rpx;
  color: var(--ink-3);
}
.menu-arrow {
  font-size: 28rpx;
  color: #CDBD9A;
}
.p-footer {
  text-align: center;
  font-size: 21rpx;
  padding: 30rpx 0 10rpx;
  color: #B4A58B;
}
.help-item {
  font-size: 24rpx;
  line-height: 1.8;
  color: var(--ink-2);
}
.help-api {
  margin: 18rpx 0 4rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  word-break: break-all;
  background: var(--surface-soft);
  color: var(--accent-ink);
}
