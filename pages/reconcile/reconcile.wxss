.rec-page {
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.mode-tabs {
  display: flex;
  gap: 12rpx;
  background: var(--surface-soft);
  border-radius: 999rpx;
  padding: 8rpx;
  margin-bottom: 24rpx;
}
.mode-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  font-weight: 500;
}
.mode-tab-active {
  background: #FFFFFF;
  color: var(--ink);
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(196, 158, 54, 0.12);
}

.drop {
  border: 2rpx dashed #E4D6AE;
  border-radius: 24rpx;
  background: #FFFDF6;
  padding: 48rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.drop:active { background: var(--gold-soft); border-color: var(--gold); }
.drop-icon { font-size: 60rpx; }
.drop-title { font-size: 30rpx; font-weight: 700; color: var(--ink); margin-top: 6rpx; }
.drop-sub { font-size: 24rpx; color: var(--ink-3); }

.raw {
  width: 100%;
  height: 320rpx;
  background: var(--surface-soft);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
}
.parse-btn { margin-top: 20rpx; padding: 22rpx 0; font-size: 28rpx; }

/* ---- 对账汇总 ---- */
.sum-row { display: flex; align-items: center; }
.sum-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.sum-label { font-size: 22rpx; color: var(--ink-3); }
.sum-value { font-size: 34rpx; font-weight: 700; color: var(--ink); }
.sum-divider { width: 1rpx; height: 52rpx; background: var(--line); }

.rec-ok { color: var(--income); }
.rec-miss { color: #B4761A; }
.rec-extra { color: var(--ink-3); }

.rec-actions { margin-top: 24rpx; }
.rec-actions .act { padding: 20rpx 0; font-size: 28rpx; }
.import-note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--income);
  text-align: center;
}

/* ---- 明细行 ---- */
.row-date {
  width: 100rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  flex-shrink: 0;
}
.row-title-line {
  display: flex;
  align-items: center;
  gap: 10rpx;
  min-width: 0;
}
.row-title {
  font-size: 27rpx;
  color: var(--ink);
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 350rpx;
}
.row-sub {
  font-size: 22rpx;
  color: var(--ink-3);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 420rpx;
}
.row-amount {
  font-size: 29rpx;
  font-weight: 700;
  margin-left: 16rpx;
  flex-shrink: 0;
}

.row-tag {
  font-size: 20rpx;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 600;
}
.rec-tag-ok { background: var(--gold-soft); color: var(--income); }
.rec-tag-miss { background: #FBF0DC; color: #B4761A; }
.rec-tag-extra { background: #F0EDE3; color: var(--ink-3); }

/* ---- 底部导出 ---- */
.set-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.set-label { font-size: 27rpx; color: var(--ink); font-weight: 500; }
.act { padding: 14rpx 44rpx; font-size: 26rpx; }
