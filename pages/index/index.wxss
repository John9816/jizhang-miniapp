/* 底部为自定义 tabBar（112rpx + 安全区）预留空间，避免最后一条账单被遮住 */
.page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

/* ============ 顶部 ============ */

.topbar-l { flex: 1; min-width: 0; }

.brand-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.brand-row:active { opacity: 0.6; }
/* 顶部账本封面小图标 */
.brand-cover {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.brand-cover image { width: 100%; height: 100%; }

/* ============ 账本切换弹层 ============ */
.ledger-scroll { max-height: 52vh; }
.ledger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid var(--line);
}
.ledger-item:active { background: var(--surface-soft); }
.ledger-item-l {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.ledger-item-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
/* 切换弹层里的账本封面缩略 */
.ledger-item-cover {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.ledger-item-cover image { width: 100%; height: 100%; }
.ledger-item-name { font-size: 30rpx; color: var(--ink); font-weight: 500; }
.ledger-item-on .ledger-item-name { color: #B8860B; font-weight: 700; }
.ledger-item-meta { font-size: 20rpx; color: var(--ink-3); }
.ledger-check { font-size: 32rpx; color: #C9A227; font-weight: 700; }
.ledger-manage { color: var(--ink-2); }
.topbar-r { display: flex; gap: 16rpx; margin-top: 6rpx; }

/* ============ 主卡 ============ */

.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 月份切换药丸：大触控目标，左右滑动主卡也可翻月 */

.mp-btn:active { background: rgba(255, 255, 255, 0.9); }

.hero-foot {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
  padding-bottom: 4rpx;
}

.hero-mascot {
  position: absolute;
  right: -14rpx;
  bottom: -16rpx;
  width: 200rpx;
  height: 216rpx;
}

.hero-coin.c1 { width: 150rpx; height: 150rpx; right: 96rpx; top: -46rpx; }
.hero-coin.c2 { width: 76rpx; height: 76rpx; right: 40rpx; top: 44rpx; opacity: 0.6; }

/* ============ 主卡内嵌预算进度 ============ */

.hero-budget:active { opacity: 0.75; }

.hb-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}

/* ============ 今日速览条（一行薄卡，仅当月显示） ============ */
.today-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 100, 40, 0.06);
}

.ts-sep { width: 1rpx; height: 24rpx; background: #EFE8D6; flex-shrink: 0; }

/* ============ 周期记账提示条（有启用中规则时常驻，一行薄卡） ============ */
.recur-hint {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 100, 40, 0.06);
}
.recur-hint-icon { font-size: 26rpx; flex-shrink: 0; }
.recur-hint-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--ink-2);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ 存钱挑战 ============ */
.challenge-card { padding: 26rpx 28rpx 22rpx; }
.ch-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.ch-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: var(--gold-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ch-emoji { font-size: 38rpx; }
.ch-main { flex: 1; min-width: 0; }
.ch-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ch-name {
  font-size: 29rpx;
  font-weight: 700;
  color: var(--ink);
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ch-tag {
  font-size: 19rpx;
  color: #A8811C;
  background: var(--surface-soft);
  border: 1rpx solid #F3E2B4;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}
.ch-meta {
  display: block;
  font-size: 23rpx;
  color: var(--ink-3);
  margin-top: 8rpx;
}
.ch-pct {
  font-size: 28rpx;
  font-weight: 700;
  color: #C08F16;
}
.ch-progress { margin-top: 20rpx; }
.ch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: var(--ink-3);
}
.ch-foot-go { color: #C0A160; }

/* ============ 快速记一笔（常用分类横滑） ============ */
.qc-head { padding: 14rpx 32rpx 0; display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.qc-templates { min-height: 80rpx; display: flex; align-items: center; padding: 0 8rpx; color: var(--accent-ink); font-size: 25rpx; border-radius: 14rpx; }
.qc-title { font-size: 24rpx; font-weight: 600; color: #8B8271; }
.quick-cats {
  width: 100%;
  white-space: nowrap;
  padding: 14rpx 28rpx 4rpx;
}
.qc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 128rpx;
}
.qc-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qc-emoji { font-size: 40rpx; }
.qc-name { font-size: 22rpx; color: var(--ink-2); }

/* ============ 成员筛选 ============ */

/* ============ 账单 ============ */
.bills-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 6rpx;
}
.bills-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}
.bills-more {
  font-size: 23rpx;
  color: var(--ink-3);
}

.bill-date-sum { color: #C0B49C; }

.bill-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
}
.bill-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bill-emoji { font-size: 36rpx; }
.bill-main { flex: 1; min-width: 0; }
.bill-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 行内次行：记账时间（HH:mm）· 备注 */

.bill-amount-muted { color: var(--ink-3); }

/* ============ 日历 ============ */
.cal-card { padding: 20rpx 16rpx 12rpx; }
.cal-weekdays { display: flex; padding: 0 6rpx 10rpx; }
.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 21rpx;
  color: var(--ink-3);
}
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}
.cal-day { font-size: 26rpx; color: var(--ink); }
.cal-out .cal-day { color: #D8D1BF; }

.cal-marks {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  margin-top: 4rpx;
  height: 44rpx;
}
.cal-amt {
  font-size: 18rpx;
  line-height: 22rpx;
  max-width: 92rpx;
  overflow: hidden;
  white-space: nowrap;
}

/* ============ 更多面板 ============ */
.more-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0 4rpx;
}
.more-grid .more-item { width: 33.333%; }
.more-hint { padding: 14rpx 28rpx 24rpx; text-align: center; color: var(--ink-3); font-size: 23rpx; line-height: 1.6; }

.more-emoji { font-size: 40rpx; }
.more-icon-wrap { position: relative; }
.more-badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 28rpx;
  padding: 0 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #F04646;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}

/* ============ 首页主题 ============ */
.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 32rpx 4rpx;
  padding-top: 26rpx;
}
.brand {
  display: block;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 42rpx;
  font-weight: 800;
  color: var(--ink);
  letter-spacing: 0;
}
.brand-sub {
  display: block;
  font-size: 24rpx;
  margin-top: 10rpx;
  color: var(--ink-3);
}
.brand-arrow {
  flex-shrink: 0;
  font-size: 30rpx;
  font-weight: 700;
  margin-top: 6rpx;
  color: var(--gold-deep);
}
.icon-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFFFFF;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(86, 54, 14, 0.08);
  color: var(--ink-2);
}
.hero {
  position: relative;
  margin: 20rpx 24rpx 0;
  padding: 32rpx 200rpx 34rpx 30rpx;
  overflow: hidden;
  margin-top: 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, var(--hero-light) 0%, var(--gold) 62%, var(--gold-deep) 100%);
  box-shadow: 0 16rpx 30rpx rgba(232, 167, 45, 0.24);
}
.hero-label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--accent-ink);
}
.month-pill {
  display: flex;
  align-items: center;
  border-radius: 999rpx;
  padding: 4rpx;
  background: rgba(255, 255, 255, 0.68);
}
.mp-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent-ink);
}
.mp-label {
  min-width: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.mp-off {
  color: var(--ink-3);
}
.hero-amount {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  margin-top: 12rpx;
  line-height: 1.12;
  letter-spacing: -1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  color: var(--ink);
}
.hero-foot-item {
  font-size: 24rpx;
  color: var(--ink);
}
.hero-sep {
  width: 1rpx;
  height: 22rpx;
  background: rgba(122, 90, 32, 0.24);
}
.hero-budget {
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(122, 90, 32, 0.18);
  padding-top: 18rpx;
}
.hb-track {
  height: 10rpx;
  border-radius: 999rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.48);
}
.hb-fill {
  height: 100%;
  border-radius: 999rpx;
  background: var(--accent-ink);
}
.hb-fill.hb-over {
  background: var(--danger);
}
.hb-text {
  font-size: 21rpx;
  color: var(--ink);
}
.hb-go {
  font-size: 21rpx;
  font-weight: 600;
  flex-shrink: 0;
  color: var(--accent-ink);
}
.hero-coin {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.08);
}
.today-strip,
.recur-hint { box-shadow: 0 8rpx 20rpx rgba(86, 54, 14, 0.06); }
.ts-item {
  font-size: 23rpx;
  color: var(--ink-3);
}
.ts-val {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--ink);
}
.ts-streak {
  font-weight: 600;
  color: var(--gold-deep);
}
.recur-hint-go {
  font-size: 22rpx;
  font-weight: 600;
  flex-shrink: 0;
  color: var(--gold-deep);
}
.qc-title,
.bills-title { color: var(--ink); }
.qc-name,
.recur-hint-text { color: var(--ink-2); }
.member-filter {
  white-space: nowrap;
  padding: 24rpx 24rpx 0;
  padding-top: 20rpx;
}
.bill-card {
  padding: 6rpx 28rpx 10rpx;
  border-color: var(--line);
}
.bill-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  padding: 20rpx 0 8rpx;
  color: var(--ink-3);
}
.bill-date-in {
  color: var(--income);
}
.bill-cate {
  font-size: 29rpx;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink);
}
.bill-member {
  font-size: 19rpx;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
  color: var(--accent-ink);
  background: var(--gold-soft);
}
.bill-sub {
  display: block;
  font-size: 22rpx;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  color: var(--ink-3);
}
.bill-amount {
  font-size: 30rpx;
  font-weight: 600;
  flex-shrink: 0;
  color: var(--ink);
}
.cal-today {
  background: var(--gold-soft);
}
.cal-today .cal-day {
  font-weight: 700;
  color: var(--income);
}
.cal-selected {
  background: var(--gold);
}
.cal-selected .cal-day {
  font-weight: 700;
  color: var(--ink);
}
.cal-amt-in {
  color: var(--income);
}
.cal-amt-out {
  color: var(--ink-2);
}
.more-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 0;
  font-size: 23rpx;
  color: var(--ink-2);
}
