.page {
  padding: 24rpx 0 180rpx;
  box-sizing: border-box;
}

/* 顶部 */
.header {
  padding: 16rpx 32rpx 0;
}

.ledger-bar {
  display: flex;
  align-items: center;
}

.ledger-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #1F2937;
}

.ledger-meta {
  font-size: 22rpx;
  color: #9CA3AF;
  margin-left: 16rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
}

.ledger-arrow {
  margin-left: 8rpx;
  color: #9CA3AF;
  font-size: 32rpx;
}

.sync-status {
  display: block;
  font-size: 20rpx;
  color: #9CA3AF;
  margin: 8rpx 0 0 4rpx;
}

.month-bar {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  color: #6B7280;
  font-size: 40rpx;
  background: #FFFFFF;
  border-radius: 50%;
}

.month-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151;
  margin: 0 28rpx;
}

/* 汇总卡片 */
.summary-card {
  display: flex;
  align-items: center;
  padding: 32rpx 16rpx;
}

.sum-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.sum-label {
  font-size: 24rpx;
  color: #9CA3AF;
}

.sum-value {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 10rpx;
}

.sum-balance {
  color: #1F2937;
}

.sum-divider {
  width: 1rpx;
  height: 48rpx;
  background: #EEF0F3;
}

/* 成员筛选 */
.member-filter {
  white-space: nowrap;
  padding: 8rpx 24rpx 8rpx 32rpx;
}

.chip {
  display: inline-block;
  padding: 10rpx 28rpx;
  margin-right: 16rpx;
  background: #FFFFFF;
  color: #6B7280;
  border-radius: 30rpx;
  font-size: 24rpx;
  border: 1rpx solid transparent;
}

.chip-active {
  background: #FFF1F0;
  color: #F04646;
  border-color: #F04646;
  font-weight: 600;
}

/* 记录分组 */
.group-card {
  padding: 8rpx 28rpx;
}

.group-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0 8rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.group-date {
  font-size: 26rpx;
  font-weight: 600;
  color: #374151;
}

.group-sub {
  display: flex;
  gap: 20rpx;
  font-size: 22rpx;
}

.record-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #F6F7F9;
}

.record-row:last-child {
  border-bottom: none;
}

.rec-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #F6F7F9;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rec-main {
  flex: 1;
  min-width: 0;
}

.rec-title {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rec-member {
  font-size: 20rpx;
  color: #B45309;
  background: #FEF3C7;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-weight: 400;
}

.rec-note {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-top: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rec-amount {
  font-size: 30rpx;
  font-weight: 700;
  margin-left: 16rpx;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  color: #9CA3AF;
  font-size: 26rpx;
  margin: 24rpx 0 40rpx;
}

.empty-btn {
  width: 320rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
}

/* 悬浮按钮 */
.fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 50%;
  background: #F04646;
  color: #FFFFFF;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(240, 70, 70, 0.35);
  z-index: 50;
}

/* 底部导航 */
.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  background: #FFFFFF;
  border-top: 1rpx solid #EEF0F3;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 40;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0 10rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1.2;
}

.tab-text {
  font-size: 20rpx;
  color: #6B7280;
  margin-top: 2rpx;
}

/* 视图切换 */
.view-toggle {
  margin-left: 16rpx;
  padding: 0 16rpx;
  font-size: 30rpx;
  color: #4F46E5;
}

/* 预算提醒横幅 */
.budget-alert {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FEF3C7;
  border: 1rpx solid #FDE68A;
}

.budget-alert-icon {
  font-size: 28rpx;
}

.budget-alert-text {
  flex: 1;
  font-size: 24rpx;
  color: #92400E;
}

.budget-alert-link {
  font-size: 24rpx;
  color: #B45309;
}

/* 功能宫格 */
.feature-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0;
}

.feature-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

.feature-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  margin-bottom: 10rpx;
}

.f-purple { background: #EDE9FE; }
.f-teal { background: #CCFBF1; }
.f-blue { background: #DBEAFE; }
.f-orange { background: #FFEDD5; }
.f-green { background: #D1FAE5; }
.f-pink { background: #FCE7F3; }
.f-indigo { background: #E0E7FF; }

.feature-text {
  font-size: 22rpx;
  color: #4B5563;
}

/* 日历视图 */
.calendar-weekdays {
  display: flex;
}

.calendar-weekday {
  width: 14.28%;
  text-align: center;
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 8rpx 0;
}

.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-cell {
  width: 14.28%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 0;
  border-radius: 12rpx;
}

.calendar-day {
  font-size: 24rpx;
  color: #374151;
}

.calendar-out {
  opacity: 0.3;
}

.calendar-today .calendar-day {
  color: #4F46E5;
  font-weight: 600;
}

.calendar-selected {
  background: #EEF2FF;
}

.calendar-marks {
  display: flex;
  gap: 4rpx;
  height: 12rpx;
}

.calendar-mark {
  font-size: 20rpx;
  line-height: 12rpx;
}

.calendar-legend {
  display: flex;
  gap: 24rpx;
  padding-top: 8rpx;
  font-size: 20rpx;
}

.day-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 28rpx 8rpx;
  font-size: 26rpx;
  color: #374151;
  font-weight: 500;
}

.day-title-sub {
  font-size: 22rpx;
  color: #9CA3AF;
  font-weight: 400;
}
