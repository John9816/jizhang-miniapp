/* 底部为自定义 tabBar（112rpx + 安全区）预留空间，避免最后一条账单被遮住 */
.page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

/* ============ 顶部 ============ */
.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 32rpx 4rpx;
}
.topbar-l { flex: 1; min-width: 0; }
.brand {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #2E2A22;
  letter-spacing: 0.5rpx;
}
.brand-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.brand-row:active { opacity: 0.6; }
/* 顶部账本封面小图标 */
.brand-cover {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.brand-cover image { width: 100%; height: 100%; }
.brand-arrow {
  font-size: 30rpx;
  color: #C9A227;
  font-weight: 700;
  margin-top: 6rpx;
}
.brand-sub {
  display: block;
  font-size: 24rpx;
  color: #A79E8B;
  margin-top: 10rpx;
}

/* ============ 账本切换弹层 ============ */
.ledger-scroll { max-height: 52vh; }
.ledger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  border-bottom: 1rpx solid #F0E9D8;
}
.ledger-item:active { background: #FAF6EA; }
.ledger-item-l {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}
.ledger-item-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}
/* 切换弹层里的账本封面缩略 */
.ledger-item-cover {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  flex-shrink: 0;
  overflow: hidden;
}
.ledger-item-cover image { width: 100%; height: 100%; }
.ledger-item-name { font-size: 30rpx; color: #2E2A22; font-weight: 500; }
.ledger-item-on .ledger-item-name { color: #B8860B; font-weight: 700; }
.ledger-item-meta { font-size: 20rpx; color: #A79E8B; }
.ledger-check { font-size: 32rpx; color: #C9A227; font-weight: 700; }
.ledger-manage { color: #6B6455; }
.topbar-r { display: flex; gap: 16rpx; margin-top: 6rpx; }
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #6B6455;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(196, 158, 54, 0.10);
}

/* ============ 主卡 ============ */
.hero {
  position: relative;
  margin: 20rpx 24rpx 0;
  /* 右侧 200rpx 留给吉祥物，文字不会压到它身上 */
  padding: 32rpx 200rpx 34rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFEDA0 0%, #FFD75E 46%, #FFC93C 100%);
  box-shadow: 0 14rpx 34rpx rgba(240, 180, 23, 0.28);
  overflow: hidden;
}
.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-label {
  font-size: 24rpx;
  color: #8A6410;
  font-weight: 500;
}
/* 月份切换药丸：大触控目标，左右滑动主卡也可翻月 */
.month-pill {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 999rpx;
  padding: 4rpx;
}
.mp-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 30rpx;
  color: #8A6410;
  font-weight: 700;
}
.mp-btn:active { background: rgba(255, 255, 255, 0.9); }
.mp-label {
  min-width: 72rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  color: #6B4E06;
}
.mp-off { color: rgba(138, 100, 16, 0.28); }
.hero-amount {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: #3A2A00;
  margin-top: 12rpx;
  line-height: 1.12;
  letter-spacing: -1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hero-foot {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
  padding-bottom: 4rpx;
}
.hero-foot-item {
  font-size: 24rpx;
  color: rgba(74, 50, 0, 0.66);
}
.hero-sep {
  width: 1rpx;
  height: 22rpx;
  background: rgba(122, 88, 10, 0.22);
}
.hero-mascot {
  position: absolute;
  right: -14rpx;
  bottom: -16rpx;
  width: 200rpx;
  height: 216rpx;
}
.hero-coin {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}
.hero-coin.c1 { width: 150rpx; height: 150rpx; right: 96rpx; top: -46rpx; }
.hero-coin.c2 { width: 76rpx; height: 76rpx; right: 40rpx; top: 44rpx; opacity: 0.6; }

/* ============ 主卡内嵌预算进度 ============ */
.hero-budget { margin-top: 20rpx; }
.hero-budget:active { opacity: 0.75; }
.hb-track {
  height: 10rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.45);
  overflow: hidden;
}
.hb-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #7A5A10;
}
.hb-fill.hb-over { background: #E2543F; }
.hb-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
}
.hb-text { font-size: 21rpx; color: rgba(74, 50, 0, 0.72); }
.hb-go { font-size: 21rpx; color: #7A5A10; font-weight: 600; flex-shrink: 0; }

/* ============ 今日速览条（一行薄卡，仅当月显示） ============ */
.today-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 100, 40, 0.06);
}
.ts-item { font-size: 23rpx; color: #A79E8B; }
.ts-val { font-size: 26rpx; font-weight: 700; color: #2E2A22; }
.ts-sep { width: 1rpx; height: 24rpx; background: #EFE8D6; flex-shrink: 0; }
.ts-streak { color: #B8860B; font-weight: 600; }

/* ============ 周期记账提示条（有启用中规则时常驻，一行薄卡） ============ */
.recur-hint {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 20rpx rgba(120, 100, 40, 0.06);
}
.recur-hint-icon { font-size: 26rpx; flex-shrink: 0; }
.recur-hint-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #6B6455;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recur-hint-go { font-size: 22rpx; color: #F5B417; font-weight: 600; flex-shrink: 0; }

/* ============ 存钱挑战 ============ */
.challenge-card { padding: 26rpx 28rpx 22rpx; }
.ch-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.ch-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #FFF3D0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ch-emoji { font-size: 38rpx; }
.ch-main { flex: 1; min-width: 0; }
.ch-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ch-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #2E2A22;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ch-tag {
  font-size: 19rpx;
  color: #A8811C;
  background: #FFF7E0;
  border: 1rpx solid #F3E2B4;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}
.ch-meta {
  display: block;
  font-size: 23rpx;
  color: #A79E8B;
  margin-top: 8rpx;
}
.ch-pct {
  font-size: 28rpx;
  font-weight: 700;
  color: #C08F16;
}
.ch-progress { margin-top: 20rpx; }
.ch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #B9B2A3;
}
.ch-foot-go { color: #C0A160; }

/* ============ 快速记一笔（常用分类横滑） ============ */
.qc-head { padding: 26rpx 32rpx 0; }
.qc-title { font-size: 24rpx; font-weight: 600; color: #8B8271; }
.quick-cats {
  width: 100%;
  white-space: nowrap;
  padding: 14rpx 28rpx 4rpx;
}
.qc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 128rpx;
}
.qc-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qc-emoji { font-size: 40rpx; }
.qc-name { font-size: 22rpx; color: #6B6455; }

/* ============ 成员筛选 ============ */
.member-filter {
  white-space: nowrap;
  padding: 24rpx 24rpx 0;
}

/* ============ 账单 ============ */
.bills-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 6rpx;
}
.bills-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2E2A22;
}
.bills-more {
  font-size: 23rpx;
  color: #A79E8B;
}
.bill-card { padding: 6rpx 28rpx 10rpx; }
.bill-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #A79E8B;
  padding: 20rpx 0 8rpx;
}
.bill-date-sum { color: #C0B49C; }
.bill-date-in { color: #D0923E; }
.bill-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
}
.bill-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bill-emoji { font-size: 36rpx; }
.bill-main { flex: 1; min-width: 0; }
.bill-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bill-cate {
  font-size: 29rpx;
  color: #2E2A22;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bill-member {
  font-size: 19rpx;
  color: #A8811C;
  background: #FFF7E0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}
/* 行内次行：记账时间（HH:mm）· 备注 */
.bill-sub {
  display: block;
  font-size: 22rpx;
  color: #A79E8B;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bill-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E2A22;
  flex-shrink: 0;
}
.bill-amount-muted { color: #A79E8B; }

/* ============ 日历 ============ */
.cal-card { padding: 20rpx 16rpx 12rpx; }
.cal-weekdays { display: flex; padding: 0 6rpx 10rpx; }
.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 21rpx;
  color: #B9B2A3;
}
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}
.cal-day { font-size: 26rpx; color: #2E2A22; }
.cal-out .cal-day { color: #D8D1BF; }
.cal-today { background: #FFF7E0; }
.cal-today .cal-day { color: #B8860B; font-weight: 700; }
.cal-selected { background: #FFD64F; }
.cal-selected .cal-day { color: #3A2A00; font-weight: 700; }
.cal-marks {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  margin-top: 4rpx;
  height: 44rpx;
}
.cal-amt {
  font-size: 18rpx;
  line-height: 22rpx;
  max-width: 92rpx;
  overflow: hidden;
  white-space: nowrap;
}
.cal-amt-in { color: #E2543F; }
.cal-amt-out { color: #9C8E6B; }

/* ============ 更多面板 ============ */
.more-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0 4rpx;
}
.more-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 0;
  font-size: 23rpx;
  color: #6B6455;
}
.more-emoji { font-size: 40rpx; }
.more-icon-wrap { position: relative; }
.more-badge {
  position: absolute;
  top: -10rpx;
  right: -18rpx;
  min-width: 28rpx;
  padding: 0 6rpx;
  height: 28rpx;
  border-radius: 999rpx;
  background: #F04646;
  color: #FFFFFF;
  font-size: 18rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
}
