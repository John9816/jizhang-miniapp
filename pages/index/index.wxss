/* 底部为自定义 tabBar（112rpx + 安全区）预留空间，避免最后一条账单被遮住 */
.page { padding-bottom: calc(150rpx + env(safe-area-inset-bottom)); }

/* ============ 顶部 ============ */
.topbar {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 32rpx 4rpx;
}
.topbar-l { flex: 1; min-width: 0; }
.brand {
  display: block;
  font-size: 42rpx;
  font-weight: 800;
  color: #2E2A22;
  letter-spacing: 0.5rpx;
}
.brand-sub {
  display: block;
  font-size: 24rpx;
  color: #A79E8B;
  margin-top: 10rpx;
}
.topbar-r { display: flex; gap: 16rpx; margin-top: 6rpx; }
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  color: #6B6455;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 14rpx rgba(196, 158, 54, 0.10);
}

/* ============ 主卡 ============ */
.hero {
  position: relative;
  margin: 20rpx 24rpx 0;
  /* 右侧 200rpx 留给吉祥物，文字不会压到它身上 */
  padding: 32rpx 200rpx 34rpx 30rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFEDA0 0%, #FFD75E 46%, #FFC93C 100%);
  box-shadow: 0 14rpx 34rpx rgba(240, 180, 23, 0.28);
  overflow: hidden;
}
.hero-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-label {
  font-size: 24rpx;
  color: #8A6410;
  font-weight: 500;
}
.hero-month {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.55);
  border-radius: 999rpx;
  padding: 4rpx 10rpx;
}
.hero-step {
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.hero-step-btn {
  width: 44rpx;
  height: 44rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
  font-size: 26rpx;
  color: #8A6410;
}
.hero-month-btn {
  width: 44rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8A6410;
  line-height: 44rpx;
}
.hero-month-disabled { color: rgba(138, 100, 16, 0.28); }
.hero-month-text {
  font-size: 22rpx;
  color: #8A6410;
  font-weight: 600;
  min-width: 52rpx;
  text-align: center;
}
.hero-amount {
  display: block;
  font-size: 64rpx;
  font-weight: 800;
  color: #3A2A00;
  margin-top: 12rpx;
  line-height: 1.12;
  letter-spacing: -1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.hero-foot {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 14rpx;
  padding-bottom: 4rpx;
}
.hero-foot-item {
  font-size: 24rpx;
  color: rgba(74, 50, 0, 0.66);
}
.hero-sep {
  width: 1rpx;
  height: 22rpx;
  background: rgba(122, 88, 10, 0.22);
}
.hero-mascot {
  position: absolute;
  right: -14rpx;
  bottom: -16rpx;
  width: 200rpx;
  height: 216rpx;
}
.hero-coin {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
}
.hero-coin.c1 { width: 150rpx; height: 150rpx; right: 96rpx; top: -46rpx; }
.hero-coin.c2 { width: 76rpx; height: 76rpx; right: 40rpx; top: 44rpx; opacity: 0.6; }

/* ============ 预算提醒 ============ */
.alert-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin: 18rpx 24rpx 0;
  padding: 16rpx 24rpx;
  background: #FFF6E2;
  border-radius: 999rpx;
}
.alert-dot { font-size: 22rpx; }
.alert-text {
  flex: 1;
  font-size: 23rpx;
  color: #8A6410;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.alert-go { font-size: 26rpx; color: #C09A3A; }

/* ============ 存钱挑战 ============ */
.challenge-card { padding: 26rpx 28rpx 22rpx; }
.ch-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.ch-icon-wrap {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  background: #FFF3D0;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.ch-emoji { font-size: 38rpx; }
.ch-main { flex: 1; min-width: 0; }
.ch-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ch-name {
  font-size: 29rpx;
  font-weight: 700;
  color: #2E2A22;
  max-width: 320rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ch-tag {
  font-size: 19rpx;
  color: #A8811C;
  background: #FFF7E0;
  border: 1rpx solid #F3E2B4;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}
.ch-meta {
  display: block;
  font-size: 23rpx;
  color: #A79E8B;
  margin-top: 8rpx;
}
.ch-pct {
  font-size: 28rpx;
  font-weight: 700;
  color: #C08F16;
}
.ch-progress { margin-top: 20rpx; }
.ch-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #B9B2A3;
}
.ch-foot-go { color: #C0A160; }

.challenge-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}
.ch-empty-title {
  display: block;
  font-size: 29rpx;
  font-weight: 700;
  color: #2E2A22;
}
.ch-empty-sub {
  display: block;
  font-size: 23rpx;
  color: #A79E8B;
  margin-top: 8rpx;
}
.ch-empty-btn {
  padding: 14rpx 34rpx;
  font-size: 25rpx;
  flex-shrink: 0;
}

/* ============ 功能宫格 ============ */
.quick {
  display: flex;
  margin: 20rpx 24rpx 0;
  padding: 26rpx 8rpx 22rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 24rpx rgba(196, 158, 54, 0.07);
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.quick-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
}
.quick-text {
  font-size: 23rpx;
  color: #6B6455;
  margin-top: 12rpx;
}

/* ============ 成员筛选 ============ */
.member-filter {
  white-space: nowrap;
  padding: 24rpx 24rpx 0;
}

/* ============ 账单 ============ */
.bills-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 6rpx;
}
.bills-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2E2A22;
}
.bills-more {
  font-size: 23rpx;
  color: #A79E8B;
}
.bill-card { padding: 6rpx 28rpx 10rpx; }
.bill-date {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 22rpx;
  color: #A79E8B;
  padding: 20rpx 0 8rpx;
}
.bill-date-sum { color: #C0B49C; }
.bill-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 18rpx 0;
}
.bill-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.bill-emoji { font-size: 36rpx; }
.bill-main { flex: 1; min-width: 0; }
.bill-title-line {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.bill-cate {
  font-size: 29rpx;
  color: #2E2A22;
  font-weight: 500;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bill-member {
  font-size: 19rpx;
  color: #A8811C;
  background: #FFF7E0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  flex-shrink: 0;
}
.bill-note {
  display: block;
  font-size: 22rpx;
  color: #A79E8B;
  margin-top: 6rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.bill-amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #2E2A22;
  flex-shrink: 0;
}
.bill-amount-muted { color: #A79E8B; }

/* ============ 日历 ============ */
.cal-card { padding: 20rpx 16rpx 12rpx; }
.cal-weekdays { display: flex; padding: 0 6rpx 10rpx; }
.cal-weekday {
  flex: 1;
  text-align: center;
  font-size: 21rpx;
  color: #B9B2A3;
}
.cal-grid { display: flex; flex-wrap: wrap; }
.cal-cell {
  width: 14.28%;
  height: 92rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
}
.cal-day { font-size: 26rpx; color: #2E2A22; }
.cal-out .cal-day { color: #D8D1BF; }
.cal-today { background: #FFF7E0; }
.cal-today .cal-day { color: #B8860B; font-weight: 700; }
.cal-selected { background: #FFD64F; }
.cal-selected .cal-day { color: #3A2A00; font-weight: 700; }
.cal-marks {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  margin-top: 4rpx;
  height: 44rpx;
}
.cal-amt {
  font-size: 18rpx;
  line-height: 22rpx;
  max-width: 92rpx;
  overflow: hidden;
  white-space: nowrap;
}
.cal-amt-in { color: #E2543F; }
.cal-amt-out { color: #9C8E6B; }

/* ============ 今日卡片 / 连续记账 ============ */
.today-row {
  display: flex;
  gap: 20rpx;
  margin: 0 28rpx 20rpx;
}
.today-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  box-shadow: 0 8rpx 24rpx rgba(120, 100, 40, 0.06);
}
.today-label { font-size: 22rpx; color: #A79E8B; }
.today-val { font-size: 34rpx; font-weight: 700; color: #2E2A22; }
.streak-card {
  width: 168rpx;
  background: linear-gradient(150deg, #FFF3D6, #FFE9AE);
  border-radius: 24rpx;
  padding: 18rpx 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 6rpx;
}
.streak-top {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
}
.streak-fire { font-size: 26rpx; }
.streak-num { font-size: 40rpx; font-weight: 700; color: #B8860B; }
.streak-unit { font-size: 20rpx; color: #B8860B; }
.streak-label { font-size: 20rpx; color: #A88F3F; }

/* ============ 本月预算进度卡 ============ */
.budget-card { margin: 0 28rpx 20rpx; }
.bc-head {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 14rpx;
}
.bc-title { font-size: 26rpx; font-weight: 600; color: #2E2A22; }
.bc-left { font-size: 30rpx; font-weight: 700; }
.bc-progress { margin-bottom: 12rpx; }
.bc-over { background: #E2543F !important; }
.bc-foot {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #A79E8B;
}
.bc-go { color: #C9A227; }

/* ============ 常用分类快捷行 ============ */
.quick-cats {
  width: 100%;
  white-space: nowrap;
  padding: 4rpx 28rpx 8rpx;
}
.qc-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  width: 128rpx;
}
.qc-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.qc-emoji { font-size: 40rpx; }
.qc-name { font-size: 22rpx; color: #6B6455; }

/* ============ 更多面板 ============ */
.more-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 12rpx 0 4rpx;
}
.more-item {
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 22rpx 0;
  font-size: 23rpx;
  color: #6B6455;
}
.more-emoji { font-size: 40rpx; }

/* ============ 云同步状态条 + 资料完善提示（非阻断） ============ */
.sync-line {
  display: flex;
  align-items: center;
  margin: 0 28rpx 16rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: #F7F2E7;
}
.sync-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #C9C0AC;
  flex-shrink: 0;
}
.sync-line.ok .sync-dot { background: #3FA34D; }
.sync-line.busy .sync-dot { background: #E9A825; }
.sync-line.bad { background: #FDEEEC; }
.sync-line.bad .sync-dot { background: #D9534F; }
.sync-text { flex: 1; min-width: 0; font-size: 22rpx; color: #8B8271; }
.sync-line.ok .sync-text { color: #6F6757; }
.sync-line.bad .sync-text { color: #B3402F; font-weight: 600; }
.sync-retry { flex-shrink: 0; font-size: 22rpx; color: #D9534F; font-weight: 700; padding-left: 16rpx; }
