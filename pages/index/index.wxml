<view class="page">
  <view class="nav-holder" style="height:{{statusBar}}px"></view>

  <!-- 顶部：账本名（点击切换） + 问候；右侧仅保留更多入口 -->
  <view class="topbar">
    <view class="topbar-l">
      <view class="brand-row" bindtap="openLedgerSheet">
        <view class="brand-cover brand-cover-img" wx:if="{{ledgerCover && ledgerCover.kind === 'image'}}">
          <image src="{{ledgerCover.image}}" mode="aspectFill" />
        </view>
        <view class="brand-cover" wx:elif="{{ledgerCover}}" style="background: {{ledgerCover.gradient}}">{{ledgerCover.emoji}}</view>
        <text class="brand">{{ledger.name || '我的账本'}}</text>
        <text class="brand-arrow">⌄</text>
      </view>
      <text class="brand-sub">{{greeting}}，今天也要存一点哦！</text>
    </view>
    <view class="topbar-r">
      <view class="icon-btn" bindtap="toggleMore">⋯</view>
    </view>
  </view>

  <!-- 云同步状态（常驻细条；失败时点按重试） -->
  <view class="sync-line {{account.tone}}" wx:if="{{cloudOn}}" bindtap="onSyncTap">
    <text class="sync-dot"></text>
    <text class="sync-text">{{account.tip}}<text wx:if="{{account.phase === 'ready'}}"> · {{syncText}}</text></text>
    <text class="sync-retry" wx:if="{{account.phase === 'failed'}}">重试 ›</text>
  </view>

  <!-- 首屏合并资料卡（非阻断，可关闭）：头像 + 昵称同一屏并排完成，昵称用 bindnickname 一键填入 -->
  <profile-fill wx:if="{{showOnboard}}" mode="onboard" bind:done="onOnboardDone" />

  <!-- 本月汇总主卡：支出大数 + 月切换 + 收入/结余 + 内嵌预算进度 -->
  <view class="hero" wx:if="{{ledger}}">
    <view class="hero-head">
      <text class="hero-label">{{monthShort}}支出（元）</text>
      <view class="hero-step">
        <text class="hero-step-btn" bindtap="prevMonth">‹</text>
        <text class="hero-step-btn {{isCurrentMonth ? 'hero-month-disabled' : ''}}" bindtap="nextMonth">›</text>
      </view>
    </view>

    <text class="hero-amount num">{{summary.expenseText}}</text>

    <view class="hero-foot">
      <text class="hero-foot-item">收入 <text class="num">{{summary.incomeText}}</text></text>
      <text class="hero-sep"></text>
      <text class="hero-foot-item">结余 <text class="num">{{summary.balanceText}}</text></text>
    </view>

    <!-- 预算进度内嵌主卡底部（替代独立预算卡与超支提醒条）；点击进预算管理 -->
    <view class="hero-budget" wx:if="{{heroBudget}}" bindtap="goBudget">
      <view class="hb-track">
        <view class="hb-fill {{heroBudget.over ? 'hb-over' : ''}}" style="width:{{heroBudget.pct}}%"></view>
      </view>
      <view class="hb-line">
        <text class="hb-text">{{heroBudget.over ? '预算已超支 ' + heroBudget.overText + ' 元' : '预算还剩 ' + heroBudget.leftText + ' 元'}} · 已用 {{heroBudget.pctText}}</text>
        <text class="hb-go">调整 ›</text>
      </view>
    </view>

    <image class="hero-mascot" src="/images/mascot.png" mode="aspectFit" />
    <view class="hero-coin c1"></view>
    <view class="hero-coin c2"></view>
  </view>

  <!-- 今日速览条：一行薄卡（翻看历史月份时隐藏） -->
  <view class="today-strip" wx:if="{{ledger && isCurrentMonth}}">
    <text class="ts-item">今日支出 <text class="num ts-val">{{today.expenseText}}</text></text>
    <text class="ts-sep"></text>
    <text class="ts-item">今日收入 <text class="num ts-val text-income">{{today.incomeText}}</text></text>
    <block wx:if="{{streak > 0}}">
      <text class="ts-sep"></text>
      <text class="ts-item ts-streak">🔥 连续 {{streak}} 天</text>
    </block>
  </view>

  <!-- 存钱挑战（仅在进行中有挑战时占用首屏；创建入口在更多面板） -->
  <view class="card challenge-card" wx:if="{{ledger && challenge}}" bindtap="goChallenge">
    <view class="ch-row">
      <view class="ch-icon-wrap">
        <text class="ch-emoji">🏆</text>
      </view>
      <view class="ch-main">
        <view class="ch-title-line">
          <text class="ch-name">{{challenge.name}}</text>
          <text class="ch-tag">进行中</text>
        </view>
        <text class="ch-meta">已存 {{challenge.savedText}} / {{challenge.targetText}}</text>
      </view>
      <text class="ch-pct num">{{challenge.pct}}%</text>
    </view>
    <view class="progress ch-progress">
      <view class="progress-bar" style="width:{{challenge.pct}}%"></view>
    </view>
    <view class="ch-foot" wx:if="{{challenge.daysLeft !== null}}">
      <text wx:if="{{challenge.daysLeft >= 0}}">距目标还有 {{challenge.daysLeft}} 天</text>
      <text wx:else>已超过计划日期 {{challenge.daysLeftAbs}} 天</text>
      <text class="ch-foot-go" wx:if="{{challengeCount > 1}}">共 {{challengeCount}} 个进行中 ›</text>
    </view>
  </view>

  <!-- 快速记一笔：常用分类横滑 -->
  <block wx:if="{{topCats.length > 0}}">
    <view class="qc-head">
      <text class="qc-title">快速记一笔</text>
    </view>
    <scroll-view scroll-x class="quick-cats" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="qc-item" wx:for="{{topCats}}" wx:key="key" bindtap="goEditWithCategory" data-key="{{item.key}}">
        <view class="qc-icon" style="background:{{item.tint}}">
          <text class="qc-emoji">{{item.icon}}</text>
        </view>
        <text class="qc-name">{{item.name}}</text>
      </view>
    </scroll-view>
  </block>

  <!-- 成员筛选 -->
  <scroll-view scroll-x class="member-filter" wx:if="{{members.length > 1}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="chip {{memberFilter === 'all' ? 'chip-active' : ''}}" bindtap="setMemberFilter" data-id="all">全部</view>
    <view wx:for="{{members}}" wx:key="id" class="chip {{memberFilter === item.id ? 'chip-active' : ''}}" bindtap="setMemberFilter" data-id="{{item.id}}">{{item.name}}</view>
  </scroll-view>

  <!-- 列表视图：账单流为页面主体；组头含完整日期+星期+当日收支，行内含记账时间 -->
  <block wx:if="{{viewMode === 'list'}}">
    <view class="bills-head">
      <text class="bills-title">最近账单</text>
      <view class="bills-more" bindtap="goSearch">全部 {{recordCount}} 笔 ›</view>
    </view>

    <view class="card bill-card" wx:if="{{groups.length > 0}}">
      <block wx:for="{{groups}}" wx:for-item="group" wx:key="date">
        <view class="bill-date">
          <text>{{group.label}}</text>
          <text class="bill-date-sum"><text wx:if="{{group.expense > 0}}">支 {{group.expenseText}}</text><text class="bill-date-in" wx:if="{{group.income > 0}}"> 收 {{group.incomeText}}</text></text>
        </view>
        <view class="bill-row" wx:for="{{group.records}}" wx:key="id" wx:for-item="rec" bindtap="onRecordTap" data-id="{{rec.id}}">
          <view class="bill-icon" style="background:{{rec.tint}}">
            <text class="bill-emoji">{{rec.icon}}</text>
          </view>
          <view class="bill-main">
            <view class="bill-title-line">
              <text class="bill-cate">{{rec.categoryName}}</text>
              <text class="bill-member" wx:if="{{rec.isOther}}">{{rec.memberName}}</text>
            </view>
            <text class="bill-sub" wx:if="{{rec.timeText || rec.note}}">{{rec.timeText}}{{rec.timeText && rec.note ? ' · ' : ''}}{{rec.note}}</text>
          </view>
          <text class="bill-amount num {{rec.type === 'income' ? 'text-income' : (rec.type === 'transfer' ? 'bill-amount-muted' : '')}}">{{rec.amountText}}</text>
        </view>
      </block>
    </view>

    <view class="empty" wx:elif="{{!loading}}">
      <text class="empty-icon">🐷</text>
      <text class="empty-text">{{emptyText}}</text>
      <view class="btn-primary empty-btn" bindtap="goEdit">记第一笔</view>
    </view>
  </block>

  <!-- 日历视图 -->
  <block wx:else>
    <view class="bills-head">
      <text class="bills-title">{{monthLabel}}</text>
      <view class="bills-more" bindtap="toggleCalendar">切回列表 ›</view>
    </view>

    <view class="card cal-card">
      <view class="cal-weekdays">
        <text class="cal-weekday" wx:for="{{calendar.weekdays}}" wx:key="*this">{{item}}</text>
      </view>
      <view class="cal-grid">
        <view class="cal-cell {{item.today ? 'cal-today' : ''}} {{selectedDay === item.date ? 'cal-selected' : ''}} {{!item.inMonth ? 'cal-out' : ''}}"
              wx:for="{{calendar.days}}" wx:key="date" bindtap="selectDay" data-day="{{item.date}}">
          <text class="cal-day">{{item.day}}</text>
          <view class="cal-marks">
            <text class="cal-amt cal-amt-in" wx:if="{{item.income > 0}}">{{item.incomeText}}</text>
            <text class="cal-amt cal-amt-out" wx:if="{{item.expense > 0}}">{{item.expenseText}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="bills-head">
      <text class="bills-title">{{selectedDay}}</text>
      <text class="bills-more" wx:if="{{dayGroups.length === 0}}">当日无记录</text>
    </view>

    <view class="card bill-card" wx:if="{{dayGroups.length > 0}}">
      <block wx:for="{{dayGroups}}" wx:for-item="group" wx:key="date">
        <view class="bill-row" wx:for="{{group.records}}" wx:key="id" wx:for-item="rec" bindtap="onRecordTap" data-id="{{rec.id}}">
          <view class="bill-icon" style="background:{{rec.tint}}">
            <text class="bill-emoji">{{rec.icon}}</text>
          </view>
          <view class="bill-main">
            <view class="bill-title-line">
              <text class="bill-cate">{{rec.categoryName}}</text>
              <text class="bill-member" wx:if="{{rec.isOther}}">{{rec.memberName}}</text>
            </view>
            <text class="bill-sub" wx:if="{{rec.timeText || rec.note}}">{{rec.timeText}}{{rec.timeText && rec.note ? ' · ' : ''}}{{rec.note}}</text>
          </view>
          <text class="bill-amount num {{rec.type === 'income' ? 'text-income' : ''}}">{{rec.amountText}}</text>
        </view>
      </block>
    </view>
  </block>

  <!-- 更多面板 -->
  <view class="sheet-mask" wx:if="{{showMore}}" bindtap="toggleMore"></view>
  <view class="sheet" wx:if="{{showMore}}">
    <view class="sheet-handle"></view>
    <view class="sheet-title">更多</view>
    <view class="more-grid">
      <view class="more-item" bindtap="openSheetItem" data-key="search">
        <text class="more-emoji">🧾</text><text>账单搜索</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="assets">
        <text class="more-emoji">💰</text><text>我的资产</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="budget">
        <text class="more-emoji">🎯</text><text>预算管理</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="challenge">
        <text class="more-emoji">🏆</text><text>存钱挑战</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="members">
        <text class="more-emoji">👥</text><text>成员共享</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="categories">
        <text class="more-emoji">🏷️</text><text>分类管理</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="recurring">
        <text class="more-emoji">🔁</text><text>周期记账</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="transfer">
        <text class="more-emoji">🔄</text><text>账户转账</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="calendar">
        <text class="more-emoji">📅</text><text>{{viewMode === 'list' ? '日历视图' : '列表视图'}}</text>
      </view>
      <view class="more-item" bindtap="openSheetItem" data-key="ledger">
        <text class="more-emoji">📒</text><text>账本管理</text>
      </view>
    </view>
    <view class="sheet-cancel" bindtap="toggleMore">取消</view>
  </view>

  <!-- 账本切换弹层：点顶部账本名弹出 -->
  <view class="sheet-mask" wx:if="{{ledgerSheet}}" bindtap="closeLedgerSheet"></view>
  <view class="sheet" wx:if="{{ledgerSheet}}">
    <view class="sheet-handle"></view>
    <view class="sheet-title">切换账本</view>
    <scroll-view scroll-y class="ledger-scroll">
      <view class="ledger-item {{item.isCurrent ? 'ledger-item-on' : ''}}" wx:for="{{ledgerOptions}}" wx:key="id" bindtap="switchLedger" data-id="{{item.id}}">
        <view class="ledger-item-l">
          <view class="ledger-item-cover ledger-item-cover-img" wx:if="{{item.cover.kind === 'image'}}">
            <image src="{{item.cover.image}}" mode="aspectFill" />
          </view>
          <view class="ledger-item-cover" wx:else style="background: {{item.cover.gradient}}">{{item.cover.emoji}}</view>
          <view class="ledger-item-text">
            <text class="ledger-item-name">{{item.name}}</text>
            <text class="ledger-item-meta" wx:if="{{item.memberCount > 1}}">{{item.memberCount}} 人共享</text>
          </view>
        </view>
        <text class="ledger-check" wx:if="{{item.isCurrent}}">✓</text>
      </view>
    </scroll-view>
    <view class="sheet-item ledger-manage" bindtap="goLedgerFromSheet">⚙️ 账本管理 / 新建账本</view>
    <view class="sheet-cancel" bindtap="closeLedgerSheet">取消</view>
  </view>
</view>
