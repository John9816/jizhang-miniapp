.page {
  padding: 16rpx 0 60rpx;
  box-sizing: border-box;
}

/* 我的身份 */
.me-row {
  display: flex;
  align-items: center;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #F7F1E2;
  color: #6B6455;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-me {
  background: #FDEEEB;
  color: #E2543F;
}

.me-info {
  flex: 1;
  min-width: 0;
}

.me-name {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #2E2A22;
}

.me-sub {
  display: block;
  font-size: 22rpx;
  color: #A79E8B;
  margin-top: 6rpx;
}

.edit-link {
  font-size: 26rpx;
  color: #E2543F;
  font-weight: 600;
}

/* 成员列表 */
.member-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #FAF5E8;
}

.member-row:last-child {
  border-bottom: none;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #2E2A22;
}

.me-tag,
.owner-tag {
  font-size: 18rpx;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  font-weight: 400;
}

.me-tag {
  color: #A8811C;
  background: #FEF3C7;
}

.owner-tag {
  color: #1D4ED8;
  background: #DBEAFE;
}

.member-sub {
  display: block;
  font-size: 20rpx;
  color: #A79E8B;
  margin-top: 6rpx;
}

.member-amounts {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  font-size: 26rpx;
  font-weight: 700;
}

.empty-members {
  padding: 40rpx 0;
  text-align: center;
  font-size: 24rpx;
}

/* 退出 */
.leave-btn {
  padding: 22rpx 0;
  font-size: 28rpx;
}

.leave-tip {
  text-align: center;
  font-size: 20rpx;
  color: #A79E8B;
  margin-top: 14rpx;
}
