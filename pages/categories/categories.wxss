.type-bar {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 24rpx 0;
}

.type-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 16rpx;
  background: #FFFFFF;
  color: var(--ink-2);
  font-size: 28rpx;
}

.type-active {
  background: var(--gold);
  color: var(--ink);
  font-weight: 500;
}

.cat-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--surface-soft);
}

.cat-icon-big {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: var(--surface-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.cat-name-input {
  flex: 1;
  min-width: 0;
  height: 80rpx;
  font-size: 28rpx;
  color: var(--ink);
}

.cat-ops {
  display: flex;
  gap: 20rpx;
}

.cat-op {
  font-size: 26rpx;
  color: var(--ink-2);
  padding: 8rpx 12rpx;
}

.cat-op-disabled {
  opacity: 0.2;
}

.cat-op-del {
  color: var(--danger);
}

.cat-add-row {
  text-align: center;
  padding: 24rpx 0 8rpx;
  font-size: 26rpx;
  color: var(--gold-deep);
}

.notice-card {
  margin: 16rpx 24rpx 0;
}

.restore-link {
  text-align: center;
  font-size: 24rpx;
  color: var(--ink-3);
  padding: 24rpx 0 60rpx;
}

.icon-pool {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  max-height: 300rpx;
  overflow-y: auto;
  margin: 16rpx 0;
}

.icon-cell {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: var(--surface-soft);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.icon-active {
  background: var(--gold-soft);
  border: 2rpx solid var(--gold-deep);
}
