.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  background: #FFFFFF;
  border-radius: 999rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: var(--ink);
}

.search-btn {
  min-height: 88rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: var(--gold);
  color: var(--ink);
  font-size: 26rpx;
}
.search-clear { display: flex; align-items: center; justify-content: center; min-height: 88rpx; min-width: 64rpx; font-size: 36rpx; color: var(--ink-3); }
.filter-toolbar { display: flex; align-items: center; gap: 16rpx; min-height: 88rpx; padding: 0 28rpx; }
.filter-summary { flex: 1; min-width: 0; color: var(--ink-2); font-size: 24rpx; line-height: 1.6; }
.filter-toggle { flex-shrink: 0; color: var(--accent-ink); font-size: 26rpx; font-weight: 600; }
.filter-apply { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin-top: 20rpx; border-radius: 16rpx; background: var(--gold); color: var(--ink); font-size: 28rpx; font-weight: 600; }

.filter-card {
  margin: 0 24rpx;
}
.date-shortcuts { display: flex; flex-wrap: wrap; gap: 12rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid var(--line); }
.date-shortcuts .fchip { padding: 16rpx 20rpx; }
.filter-error { margin-top: 16rpx; padding: 16rpx 20rpx; border-radius: 12rpx; color: var(--gold-deep); background: var(--gold-soft); font-size: 24rpx; line-height: 1.6; }

.filter-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--surface-soft);
}

.filter-row:last-child {
  border-bottom: none;
}

.filter-label {
  width: 64rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  flex-shrink: 0;
}

.filter-chips {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
  flex: 1;
}

.fchip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-soft);
  color: var(--ink-2);
  font-size: 24rpx;
  flex-shrink: 0;
}

.fchip-active {
  background: var(--gold-soft);
  color: var(--gold-deep);
}

.fchip-input {
  width: 140rpx;
  height: 72rpx;
  padding: 0 12rpx;
  text-align: center;
  background: var(--surface-soft);
}

.filter-sep {
  font-size: 24rpx;
  color: var(--ink-3);
}

.filter-reset {
  margin-left: auto;
  font-size: 24rpx;
  color: var(--ink-3);
}

.result-summary {
  display: flex;
  margin: 16rpx 24rpx 0;
  padding: 24rpx;
}

.result-summary .sum-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.result-summary .sum-label {
  font-size: 22rpx;
  color: var(--ink-2);
}

.result-summary .sum-value {
  font-size: 30rpx;
  font-weight: 600;
}

.result-summary .sum-divider {
  width: 1rpx;
  background: var(--line);
}
