<!-- 头像 + 昵称「合并资料卡」：同一屏并排完成两项采集，昵称优先用 bindnickname 一键填入 -->
<view class="pf {{mode === 'onboard' ? 'pf-onboard' : 'pf-edit'}}">
  <view class="pf-bar" wx:if="{{mode === 'onboard'}}">
    <text class="pf-title">完善资料，记账更有归属感</text>
    <view class="pf-x" bindtap="onClose">✕</view>
  </view>

  <view class="pf-main">
    <button class="pf-av-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image class="pf-av" src="{{localAvatar || '/images/avatar.png'}}" mode="aspectFill" binderror="onAvatarErr" />
      <view class="pf-cam">📷</view>
    </button>

    <view class="pf-fields">
      <input
        class="pf-input"
        type="nickname"
        value="{{localName}}"
        placeholder="{{mode === 'onboard' ? '给自己起个名字' : '点击设置微信昵称'}}"
        maxlength="12"
        bindnickname="onNicknamePick"
        bindinput="onNicknameInput"
        bindblur="onNicknameBlur"
      />
      <text class="pf-tip" wx:if="{{mode === 'onboard'}}">点 📷 从微信选头像 · 昵称聚焦后点键盘顶部「微信昵称」一键填入</text>
    </view>
  </view>

  <button class="pf-done" wx:if="{{mode === 'onboard'}}" bindtap="onComplete">完成</button>
</view>
