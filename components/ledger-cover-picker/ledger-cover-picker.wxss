.cover-picker {
  margin-top: 8rpx;
}

.cover-picker-title {
  font-size: 26rpx;
  color: var(--ink-2, #6B6455);
  margin-bottom: 16rpx;
}

.cover-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}

.cover-tile {
  width: calc(25% - 16rpx);
  margin: 8rpx;
  height: 112rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 3rpx solid transparent;
}

.cover-tile:active {
  transform: scale(0.96);
}

.cover-tile-on {
  border-color: var(--gold-deep, #F5B417);
}

.cover-tile-emoji {
  font-size: 44rpx;
  line-height: 1.1;
}

.cover-tile-name {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: var(--ink-2, #6B6455);
}

.cover-tile-img {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.cover-tile-name-img {
  position: relative;
  z-index: 1;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 16rpx;
  padding: 2rpx 14rpx;
}

.cover-tile-album {
  background: var(--gold-soft, #FFF3D0);
  border: 3rpx dashed var(--gold-deep, #F5B417);
}
