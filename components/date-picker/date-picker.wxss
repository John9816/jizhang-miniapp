:host { display:block; }
.calendar-button { width:auto; min-width:0; box-sizing:border-box; display:flex; align-items:center; justify-content:center; margin:0; padding:0; border:0; border-radius:16rpx; font-size:28rpx; color:#3D301C; background:transparent; line-height:1.4; }
.calendar-button::after { border:0; }
.calendar-button:active { opacity:.7; }
.calendar-mask { position:fixed; inset:0; z-index:3000; background:rgba(36,28,14,.46); display:flex; align-items:flex-end; }
.calendar-sheet { width:100%; box-sizing:border-box; padding:28rpx 32rpx calc(24rpx + env(safe-area-inset-bottom)); border-radius:36rpx 36rpx 0 0; background:#FFFDF7; color:#3D301C; animation:calendar-in .22s ease-out; max-height:94vh; overflow:auto; }
.calendar-top { display:flex; align-items:center; justify-content:space-between; }
.calendar-title { font-size:34rpx; font-weight:700; }
.close { width:76rpx; height:76rpx; font-size:42rpx; }
.calendar-selected { font-size:26rpx; color:#8A6D36; margin-bottom:12rpx; }
.calendar-nav { display:flex; align-items:center; justify-content:space-between; margin:8rpx 0 16rpx; }
.arrow { width:88rpx; height:80rpx; font-size:44rpx; background:#FFF1CD; }
.month-title { flex:1; height:80rpx; font-weight:700; }
.weekdays,.days { display:grid; grid-template-columns:repeat(7,minmax(0,1fr)); gap:6rpx; }
.weekday { text-align:center; padding:12rpx 0; color:#9B8A6A; font-size:24rpx; }
.day { width:100%; height:76rpx; display:flex; align-items:center; justify-content:center; border-radius:20rpx; font-size:28rpx; }
.outside { color:#AD9E82; }
.today { box-shadow:inset 0 0 0 2rpx #E6B137; }
.selected { background:#F6C443; color:#3D301C; font-weight:800; box-shadow:none; }
.disabled { opacity:.25; }
.months { display:grid; grid-template-columns:repeat(3,1fr); gap:16rpx; padding:16rpx 0; min-height:470rpx; }
.month-cell { background:#FFF1CD; display:flex; align-items:center; justify-content:center; }
.shortcuts { display:flex; gap:12rpx; margin:20rpx 0; flex-wrap:wrap; }
.shortcut { padding:16rpx 22rpx; font-size:24rpx; background:#F7F0DF; }
.calendar-actions { display:flex; gap:16rpx; }
.action-button { flex:1; padding:24rpx 0; font-weight:700; }
.cancel { background:#F7F0DF; }
.confirm { background:#F6C443; }
@keyframes calendar-in { from { transform:translateY(40rpx); opacity:0; } to { transform:translateY(0); opacity:1; } }
