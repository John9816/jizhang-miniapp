# 记账本小程序后端配置示例。部署脚本会复制为 /opt/jizhang-api/.env（权限 600）。
# 注意：.env 含 AppSecret，只保存在服务器上，绝不要写进小程序代码或提交到 git。

# ---- 小程序账号（mp.weixin.qq.com → 开发管理 → 开发设置）----
APPID=wxXXXXXXXXXXXXXXXXXXXXXXXX
APPSECRET=your_appsecret_here_32chars

# ---- 服务监听 ----
# 线上架构：TLS 由 nginx（certbot 证书）终止，本服务只监听 127.0.0.1:3123，
# nginx conf.d/jizhang-api.conf 反代到此端口。改端口记得同步改 nginx 的 proxy_pass。
PORT=3123
HOST=127.0.0.1

# ---- 证书：留空表示以 HTTP 启动（nginx 已终止 TLS，此处无需配置）----
# 仅当需要本服务直连 HTTPS（不经 nginx）时才填写：
# CERT_KEY=/etc/ssl/jizhang/api.key
# CERT_CHAIN=/etc/ssl/jizhang/fullchain.cer
CERT_KEY=
CERT_CHAIN=

# ---- 数据（数据库与备份目录，相对 WorkingDirectory=/opt/jizhang-api）----
DATA_DIR=./data

# ---- 本地调试 ----
# =1 时跳过微信服务器：任意 code 直接映射为 mock_<code>，仅本机冒烟用
MOCK_WX=0
